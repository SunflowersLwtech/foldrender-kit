        "$(json_arg "$key")" "$sub" "$(json_arg "$title")" "${product:+,\"product\":$(json_arg "$product")}" "${state:+,\"state\":$(json_arg "$state")}" "${base:+,\"base\":$base}" "${body#,}" > "$TMP/req"
      desk_api POST /items -H "Content-Type: application/json" --data-binary "@$TMP/req"
