      [ $# -eq 0 ] || shift
      case "$key" in ''|-*) die 2 "desk $sub KEY ...: KEY names the thing (letters, digits, . _ : -), the same key again changes it" ;; esac
      local title="" product="" state="" context="" suggest="" deadline="" need="" heavy="" input="" device="" minutes="" session="" next="" at="" star="" match="" until="" reply="" base=""
      local opts=() links=()
      while [ $# -gt 0 ]; do
        case "$1" in
          --title) need $# "$1"; title="$2"; shift 2 ;;
          --product) need $# "$1"; product="$2"; shift 2 ;;
          --state) need $# "$1"; state="$2"; shift 2 ;;
          --context) need $# "$1"; context="$2"; shift 2 ;;
          --suggest) need $# "$1"; suggest="$2"; shift 2 ;;
          --option) need $# "$1"; opts+=("$2"); shift 2 ;;
          --deadline) need $# "$1"; deadline="$(desk_when "$2")" || exit 2; shift 2 ;;
          --hands) need=hands; shift ;;
          --heavy) heavy=1; shift ;;
          --input) input=1; shift ;;
          --device) need $# "$1"; device="$2"; shift 2 ;;
          --minutes) need $# "$1"; minutes="$2"; shift 2 ;;
          --session) need $# "$1"; session="$2"; shift 2 ;;
          --next) need $# "$1"; next="$2"; shift 2 ;;
          --at) need $# "$1"; at="$(desk_when "$2")" || exit 2; shift 2 ;;
          --star) star=1; shift ;;
          --match) need $# "$1"; match="$2"; shift 2 ;;
          --note) need $# "$1"; [ "$sub" = known ] && title="$2" || die 2 "--note is for desk known and desk done"; shift 2 ;;
          --until) need $# "$1"; until="$(desk_when "$2")" || exit 2; shift 2 ;;
          --link) need $# "$1"; links+=("$2"); shift 2 ;;
