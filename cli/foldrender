      while [ $# -gt 0 ]; do
        case "$1" in
          --sent) st=sent; shift ;;
          --doing) st=doing; shift ;;
          --done) need $# "$1"; st=done; result="$2"; shift 2 ;;
          *) die 2 "desk ack ID --sent | --doing | --done TEXT" ;;
        esac
      done
