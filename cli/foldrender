      done
      [ -z "$result" ] || [ "$st" != read ] || die 2 "--result goes with doing or done"
      for k in ${keys[@]+"${keys[@]}"}; do kl="$kl${kl:+,}$(json_arg "$k")"; done
      [ -z "$all" ] || [ -z "$kl" ] || die 2 "--key or --all, not both"
      printf '{"state":"%s"%s%s%s%s}' "$st" "${result:+,\"result\":$(json_arg "$result")}" "${kl:+,\"keys\":[$kl]}" "${all:+,\"all\":true}" "${correct:+,\"correct\":true}" > "$TMP/req"
