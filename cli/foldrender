      # answer). --correct: an answer this token marked, set as it should be.
      local batch="${1:-}" st="${2:-}" result="" all="" correct=""
      [ $# -lt 2 ] || shift 2
      case "$batch" in ''|*[!0-9]*) die 2 "desk mark BATCH read|doing|done [--result TEXT] [--key KEY]... [--all] [--correct]" ;; esac
      case "$st" in read|doing|done) ;; *) die 2 "desk mark BATCH read|doing|done [--result TEXT] [--key KEY]... [--all] [--correct]" ;; esac
