    ;;
    edit) cat <<'EOF'
foldrender edit PAGE --old TEXT --new TEXT [--old TEXT --new TEXT ...] [--base REV] [--title T]
foldrender edit PAGE --edits FILE|-    (JSON: [{"old": "...", "new": "..."}, ...])
