# help_asked CMD ARG...: whether ARGs ask for CMD's help (-h or --help), not
# counting the value of an option that takes one (edit --old --help).
help_asked() {
  local cmd="$1" skip="" a
  shift
  for a in "$@"; do
    if [ -n "$skip" ]; then skip=""; continue; fi
    case "$a" in
      -h|--help) return 0 ;;
      --old|--new|--title|--name|--folder|--share|--slug|--edits|--patch|--base|--assets|--save|-o|\
      --section|--card|--from|--max-tokens|--max-chars|--meta|--access|-n|--add|--rm|--note|--owner|\
      --confirm|--token|--timeout|--after|--notify|--ack|--to|--idempotency-key|--page|--agent|--dir|\
      --desk|--role|--context|--suggest|--option|--deadline|--product|--state|--device|--minutes|--session|\
      --next|--at|--match|--until|--reply-url|--lang|--done) skip=1 ;;
      --link) [ "$cmd" != canvas ] || skip=1 ;;
    esac
  done
  return 1
}

main() {
  local cmd="${1:-help}"
  [ $# -eq 0 ] || shift
  case "$cmd" in
    login|logout|account|export|whoami|publish|edit|share|list|ls|read|cat|versions|restore|undo|canvas|answers|desk|bridge|rm|delete|open|version)
      if help_asked "$cmd" "$@"; then
        case "$cmd" in
          list) cmd_help ls ;;
          cat) cmd_help read ;;
          version) cmd_help ;;
          *) cmd_help "$cmd" ;;
        esac
        return 0
      fi ;;
  esac
  case "$cmd" in
    login) cmd_login "$@" ;;
    logout) cmd_logout ;;
    account) cmd_account "$@" ;;
    export) cmd_export "$@" ;;
    whoami) cmd_whoami ;;
    publish) cmd_publish "$@" ;;
    edit) cmd_edit "$@" ;;
    share) cmd_share "$@" ;;
    list|ls) cmd_list "$@" ;;
    read|cat) cmd_read "$@" ;;
    versions) cmd_versions "$@" ;;
    restore) cmd_restore "$@" ;;
    undo) cmd_undo "$@" ;;
    canvas) cmd_canvas "$@" ;;
    answers) cmd_answers "$@" ;;
    desk) cmd_desk "$@" ;;
    bridge) cmd_bridge "$@" ;;
    rm|delete) cmd_rm "$@" ;;
    open) cmd_open "$@" ;;
    version|--version) printf 'foldrender %s\n' "$FR_CLI_VERSION" ;;
    help|-h|--help) cmd_help "$@" ;;
    *) die 2 "unknown command: $cmd (try: foldrender help)" ;;
  esac
}

TOKEN="$(read_token)"
main "$@"
