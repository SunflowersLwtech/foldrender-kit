    fi
    [ -n "$DESK_ID" ] || DESK_ID=desk
  fi
  set -- ${rest[@]+"${rest[@]}"}
  case "$DESK_ID" in http://*|https://*) page_id "$DESK_ID"; DESK_ID="$PAGE_ID" ;; esac
  check_slug "$DESK_ID"
  case "$sub" in
    init)
      local name="" title="" lang=""
      while [ $# -gt 0 ]; do
        case "$1" in
          --name) need $# "$1"; name="$2"; shift 2 ;;
          --title) need $# "$1"; title="$2"; shift 2 ;;
          --lang) need $# "$1"; lang="$2"; shift 2 ;;
