          [ "${STATUS#2}" != "$STATUS" ] || desk_fail
          [ "$mode" = json ] && { cat "$TMP/body"; printf '\n'; return 0; }
          sed -n 's/.*"token" *: *"\(frdk_[^"]*\)".*/\1/p' "$TMP/body"
