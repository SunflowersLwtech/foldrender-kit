      local q=""
      while [ $# -gt 0 ]; do
        case "$1" in
          --all) q="${q}all=1&"; shift ;;
          --after) need $# "$1"; case "$2" in ''|*[!0-9]*) die 2 "--after takes an answer's id" ;; esac; q="${q}after=$2&"; shift 2 ;;
          *) die 2 "desk inbox [--all] [--after ID] [--json]" ;;
        esac
      done
      q="${q%&}"
      [ "$mode" = json ] && ACCEPT="application/json" || ACCEPT="text/plain"
      desk_api GET "/inbox${q:+?$q}"
      [ "${STATUS#2}" != "$STATUS" ] || desk_fail
      cat "$TMP/body"
      [ "$mode" != json ] || printf '\n'
      ;;
    ack)
      local id="${1:-}" st="" result=""
      [ $# -eq 0 ] || shift
