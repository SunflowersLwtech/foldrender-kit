      [ -z "$context" ] || body="$body,\"context\":$(json_arg "$context")"
      [ -z "$ol" ] || body="$body,\"options\":[$ol]"
      [ -z "$product" ] || body="$body,\"product\":$(json_arg "$product")"
      [ -z "$by" ] || body="$body,\"by\":$(json_arg "$by")"
      [ -z "$machine" ] || body="$body,\"machine\":$(json_arg "$machine")"
      [ -z "$deadline" ] || body="$body,\"deadline\":$(json_arg "$deadline")"
      [ -z "$heavy" ] || body="$body,\"heavy\":true"
      [ ${#links[@]} -eq 0 ] || body="$body,\"links\":$(desk_links "${links[@]}")"
      [ -z "$il" ] || body="$body,\"images\":[$il]"
      printf '{"cards":[{%s}]}' "$body" > "$TMP/req"
      desk2_api POST /cards -H "Content-Type: application/json" --data-binary "@$TMP/req"
