      [ -n "$file" ] || die 2 "desk feed SOURCE FILE.json|- (the file: {\"every_s\": 60, \"items\": [...]})"
      if [ "$file" = - ]; then cat > "$TMP/feed"; file="$TMP/feed"; fi
      [ -f "$file" ] || die 2 "no file $file"
      desk_api PUT "/feed/$source" -H "Content-Type: application/json" --data-binary "@$file"
      [ "${STATUS#2}" != "$STATUS" ] || desk_fail
      [ "$mode" = json ] && { cat "$TMP/body"; printf '\n'; return 0; }
