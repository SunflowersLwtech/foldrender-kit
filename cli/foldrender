      [ ${#opts[@]} -le 3 ] || die 2 "at most 3 --option"
      local body="" i=1 o ol=""
      for o in ${opts[@]+"${opts[@]}"}; do ol="$ol${ol:+,}{\"id\":\"o$i\",\"label\":$(json_arg "$o")}"; i=$((i + 1)); done
      [ -z "$context" ] || body="$body,\"context\":$(json_arg "$context")"
      [ -z "$suggest" ] || body="$body,\"suggest\":$(json_arg "$suggest")"
      [ -z "$ol" ] || body="$body,\"options\":[$ol]"
      [ -z "$deadline" ] || body="$body,\"deadline\":$(json_arg "$deadline")"
      [ -z "$need" ] || body="$body,\"need\":\"hands\""
      [ -z "$heavy" ] || body="$body,\"heavy\":true"
      [ -z "$input" ] || body="$body,\"input\":true"
      [ -z "$device" ] || body="$body,\"device\":$(json_arg "$device")"
      [ -z "$minutes" ] || body="$body,\"minutes\":$minutes"
      [ -z "$session" ] || body="$body,\"session\":$(json_arg "$session")"
      [ -z "$next" ] || body="$body,\"next_check\":$(json_arg "$next")"
      [ -z "$at" ] || body="$body,\"at\":$(json_arg "$at")"
      [ -z "$star" ] || body="$body,\"star\":true"
      [ -z "$match" ] || body="$body,\"match\":$(json_arg "$match")"
      [ -z "$until" ] || body="$body,\"until\":$(json_arg "$until")"
      [ -z "$reply" ] || body="$body,\"reply_url\":$(json_arg "$reply")"
      [ ${#links[@]} -eq 0 ] || body="$body,\"links\":$(desk_links "${links[@]}")"
