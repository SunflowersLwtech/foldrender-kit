  card KEY --question "one line" --suggest "what you would do"
      [--context TEXT (300)] [--option LABEL]... (at most 2) [--heavy]
      [--deadline 2026-10-23[T10:00]] [--product P] [--by SESSION]
      [--machine M] [--link URL[=LABEL]]... (at most 3)
      [--image FILE[=LABEL]]... (at most 3)
