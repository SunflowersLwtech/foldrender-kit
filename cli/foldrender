#!/usr/bin/env bash
# foldrender: publish an HTML file and get a link you can share, and read a
# published page back as text.
#
# Needs only bash, curl (7.55 or later, for -H @file) and coreutils, so it runs
# on macOS's bash 3.2 and on Linux. `publish` and `edit` write nothing to stdout
# but the page's address, one line a page, so an agent can capture it; the
# revision, notes and warnings go to stderr, one line each. Other commands print
# to stdout, briefly by default; --json prints the API's answer as it is.
#
#   FOLDRENDER_TOKEN       API token; takes precedence over the saved login.
#   FOLDRENDER_API         API base URL (default https://a.foldrender.dev, the API
#                          host; the links it hands out are on foldrender.dev).
#   FOLDRENDER_NO_BROWSER  Set to 1 to print the sign-in link, not open it.
#   FOLDRENDER_READ_MAX_TOKENS  How much `read` prints before it stops, says how
#                          to go on and lists the sections (default 6000,
#                          about; 0 for no limit).
#
# Exit codes: 0 ok, 1 failed, 2 bad usage, 3 not signed in or token rejected,
# 4 free-plan limit reached, 5 page too large, 6 network failure,
# 7 no such page, or not visible to this account (read), 8 page expired (read).

export LC_ALL=C

API="${FOLDRENDER_API:-https://a.foldrender.dev}"
API="${API%/}"
MAX_BYTES=5242880
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/foldrender"
TOKEN_FILE="$CONFIG_DIR/token"
SLUG_MAP="$CONFIG_DIR/slugs"

TMP="$(mktemp -d "${TMPDIR:-/tmp}/foldrender.XXXXXX")" || exit 1
trap 'rm -rf "$TMP"' EXIT
trap 'exit 130' INT TERM

STATUS=""
ACCEPT="text/plain"

die() {
  local code="$1"
  shift
  printf 'foldrender: %s\n' "$*" >&2
  exit "$code"
}

note() {
  printf 'foldrender: %s\n' "$*" >&2
}

# need COUNT FLAG: a flag that takes a value must not be the last argument.
need() {
  [ "$1" -ge 2 ] || die 2 "$2 needs a value"
}

read_token() {
  if [ -n "${FOLDRENDER_TOKEN:-}" ]; then
    printf '%s' "$FOLDRENDER_TOKEN"
  elif [ -f "$TOKEN_FILE" ]; then
    head -n 1 "$TOKEN_FILE" | tr -d ' \t\r\n'
  fi
}

require_token() {
  [ -n "$TOKEN" ] || die 3 "not signed in. Run: foldrender login"
}

# api METHOD PATH [curl args...]: sets STATUS and leaves the body in $TMP/body.
# A failed connection exits here. HTTP errors are reported by the caller.
api() {
  local method="$1" path="$2" rc
  shift 2
  STATUS="$(curl -sS -X "$method" --connect-timeout 15 --max-time 300 \
    -H "Accept: $ACCEPT" -H "FoldRender-API: 2" -o "$TMP/body" -w '%{http_code}' "$@" \
    "$API$path" 2>"$TMP/err")"
  rc=$?
  if [ "$rc" -ne 0 ]; then
    die 6 "cannot reach $API. Check your network connection and try again. ($(sed 's/^curl: ([0-9]*) //' "$TMP/err" | head -n 1))"
  fi
}

# auth_header: prints a curl -H argument that names a file holding the
# Authorization header, so the token is never in curl's argument list, which
# any user of the machine can read (ps). The file is in this run's private
# temporary directory, written with the shell's builtin printf, so no program
# is started with the token among its arguments, and rewritten each time,
# since login changes the token mid-run.
auth_header() {
  ( umask 077 && printf 'Authorization: Bearer %s\n' "$TOKEN" > "$TMP/auth" ) || die 1 "cannot write $TMP/auth"
  printf '@%s' "$TMP/auth"
}

api_auth() {
  require_token
  api "$@" -H "$(auth_header)"
}

# The server's message for either "error: text" or {"error":"text"} bodies.
error_text() {
  local t
  t="$(head -n 1 "$TMP/body" | tr -d '\r')"
  case "$t" in
    error:*) t="${t#error:}" ;;
    *'"error"'*) t="$(printf '%s' "$t" | sed -n 's/.*"error" *: *"\([^"]*\)".*/\1/p')" ;;
  esac
  t="${t# }"
  printf '%s' "${t:-no message}"
}

fail_http() {
  local msg
  msg="$(error_text)"
  case "$STATUS" in
    401) die 3 "not signed in, or the token was rejected ($msg). Run: foldrender login" ;;
    403)
      if grep -q quota_exceeded "$TMP/body"; then
        die 4 "free plan limit reached: 10 pages, each kept for 30 days. See your pages with: foldrender list"
      fi
      die 1 "not allowed ($msg)" ;;
    404) die 1 "not found ($msg)" ;;
    413) die 5 "the page is larger than 5 MB" ;;
    *) die 1 "the server returned HTTP $STATUS ($msg)" ;;
  esac
}

expect_2xx() {
  case "$STATUS" in
    2??) return 0 ;;
  esac
  fail_http
}

# A page's name or folder in its address: lowercase letters, digits and
# hyphens, starting with a letter or digit, up to 63.
check_name() {
  case "$1" in
    ''|[!a-z0-9]*|*[!a-z0-9-]*) die 2 "$2 takes lowercase letters, digits and hyphens, starting with a letter or digit: $1" ;;
  esac
  [ "${#1}" -le 63 ] || die 2 "$2 is at most 63 characters: $1"
}

# A page slug is letters, digits, hyphens and underscores. Checking it here
# keeps a typo like "a/b" from becoming a different API path.
check_slug() {
  case "$1" in
    ''|*[!A-Za-z0-9_-]*) die 2 "not a page slug: $1" ;;
  esac
}

# GitHub logins: letters, digits and single hyphens, comma-separated.
check_logins() {
  case "$1" in
    ''|-*|*[!A-Za-z0-9,-]*|,*|*,|*,,*) die 2 "not a comma-separated list of GitHub logins: $1" ;;
  esac
}

# json_array a,b: the JSON array ["a","b"]. The API wants arrays for share_add
# and share_remove, not strings. Logins were checked by check_logins first.
json_array() {
  printf '['
  printf '%s' "$1" | awk -F, '{ for (i = 1; i <= NF; i++) printf "%s\"%s\"", (i > 1 ? "," : ""), $i }'
  printf ']'
}

# A slug, or a page URL, to the slug.
slug_from() {
  local s="${1%%[?#]*}"
  s="${s%/}"
  printf '%s' "${s##*/}"
}

# The link token in a page address (?k=...), if any.
token_from() {
  case "$1" in
    *[?\&]k=*) local k="${1#*[?&]k=}"; printf '%s' "${k%%[&#]*}" ;;
  esac
}

# page_id TARGET: sets PAGE_ID to the id of the page TARGET names, and PAGE_K to
# its link token when TARGET carries one. TARGET is an id, a link by id
# (https://foldrender.dev/artifacts/-/<id>, or an old a.foldrender.dev/<id>), a library link
# (...?open=<id>), or a page's address (https://foldrender.dev/artifacts/<owner>/
# [<folder>/]<name>), which the API resolves to its id. Not run in a subshell,
# because a die inside $(...) would only end the subshell.
page_id() {
  local path
  PAGE_ID="" PAGE_K="$(token_from "$1")"
  case "$1" in
    *[?\&]open=*) PAGE_ID="${1#*open=}"; PAGE_ID="${PAGE_ID%%[&#]*}" ;;
    http://*/artifacts/-/*|https://*/artifacts/-/*) PAGE_ID="$(slug_from "$1")" ;;
    http://*/artifacts/*|https://*/artifacts/*)
      path="/artifacts/${1#*/artifacts/}"
      path="${path%%[?#]*}"
      if [ -n "$TOKEN" ]; then
        api GET "/api/resolve?path=$(urlencode "$path")${PAGE_K:+&k=$PAGE_K}" -H "$(auth_header)"
      else
        api GET "/api/resolve?path=$(urlencode "$path")${PAGE_K:+&k=$PAGE_K}"
      fi
      case "$STATUS" in
        200) PAGE_ID="$(sed -n 's/.*"id" *: *"\([^"]*\)".*/\1/p' "$TMP/body" | head -n 1)" ;;
        401) die 3 "$1 is not public. Sign in to use it: foldrender login" ;;
        404) die 7 "no page at $1, or it is not visible to this account" ;;
        *) fail_http ;;
      esac
      [ -n "$PAGE_ID" ] || die 1 "the server did not say which page $1 is"
      ;;
    *) PAGE_ID="$(slug_from "$1")" ;;
  esac
}

# Percent-encodes every byte except unreserved characters.
urlencode() {
  local s="$1" out="" i=0 c
  while [ "$i" -lt "${#s}" ]; do
    c="${s:$i:1}"
    case "$c" in
      [A-Za-z0-9._~-]) out="$out$c" ;;
      # bash 3.2 sign-extends bytes above 0x7F, so mask down to one byte.
      *) out="$out$(printf '%%%02X' $(( $(printf '%d' "'$c") & 255 )))" ;;
    esac
    i=$((i + 1))
  done
  printf '%s' "$out"
}

# The absolute path of FILE, with symlinks in its directory resolved.
abs_path() {
  local dir
  dir="$(cd "$(dirname "$1")" && pwd -P)" || return 1
  printf '%s/%s\n' "$dir" "$(basename "$1")"
}

# The page's own <title>: the first one. An inline SVG can carry <title>s of its
# own further down, and a greedy match would pick the last of them.
title_from() {
  tr '\n' ' ' < "$1" | grep -o '<title[^>]*>[^<]*</title>' | head -n 1 \
    | sed 's/<title[^>]*>//; s/<\/title>//; s/^ *//; s/ *$//' \
    | sed 's/&lt;/</g; s/&gt;/>/g; s/&quot;/"/g; s/&#39;/'"'"'/g; s/&apos;/'"'"'/g; s/&nbsp;/ /g; s/&amp;/\&/g'
}

# The slug named by <meta name="foldrender-slug" content="...">, if any.
meta_slug() {
  local tag
  tag="$(grep -o '<meta[^>]*foldrender-slug[^>]*>' "$1" | head -n 1)"
  printf '%s' "$tag" | sed -n 's/.*content="\([^"]*\)".*/\1/p'
}

warn_if_secrets() {
  if grep -Eq '(^|[^A-Za-z0-9])(sk-|ghp_|frat_)[A-Za-z0-9_-]{16,}|AKIA[0-9A-Z]{16}|-----BEGIN ' "$1"; then
    note "warning: this page looks like it contains a secret (an API key, token or private key). Anyone with the link can read it."
  fi
}

# The slug map: one "absolute-path<TAB>slug" line per published file.
map_lookup() {
  [ -f "$SLUG_MAP" ] || return 0
  awk -F'\t' -v k="$1" '($1 "") == (k "") { s = $2 } END { if (s != "") print s }' "$SLUG_MAP"
}

# map_without COLUMN VALUE: the map minus the rows whose COLUMN is VALUE.
# COLUMN 1 is the path, COLUMN 2 is the slug.
map_without() {
  awk -F'\t' -v c="$1" -v v="$2" '((c == 1 ? $1 : $2) "") != (v "")' "$SLUG_MAP"
}

map_forget() {
  [ -f "$SLUG_MAP" ] || return 0
  map_without "$1" "$2" > "$SLUG_MAP.tmp" && mv -f "$SLUG_MAP.tmp" "$SLUG_MAP"
}

map_set() {
  mkdir -p "$CONFIG_DIR"
  {
    [ -f "$SLUG_MAP" ] && map_without 1 "$1"
    printf '%s\t%s\n' "$1" "$2"
  } > "$SLUG_MAP.tmp" && mv -f "$SLUG_MAP.tmp" "$SLUG_MAP"
}

# upload METHOD PATH FILE QUERY
upload() {
  api_auth "$1" "$2${4:+?$4}" -H "Content-Type: text/html" --data-binary "@$3"
}

# Sets PAGE_URL, and PAGE_ID, from the body of a successful write: the URL on
# the first line, then `id=<id>` from a server that has page addresses (an
# older one sends the link by id alone, whose last part is the id). Not run in a
# subshell, because a die inside $(...) would only end the subshell.
read_page_url() {
  PAGE_URL="$(head -n 1 "$TMP/body" | tr -d '\r')"
  case "$PAGE_URL" in
    http*) ;;
    *) die 1 "the server did not return a page URL ($(error_text))" ;;
  esac
  PAGE_ID="$(field id)"
  [ -n "$PAGE_ID" ] || PAGE_ID="$(slug_from "$PAGE_URL")"
}

open_url() {
  [ "${FOLDRENDER_NO_BROWSER:-}" = 1 ] && return 0
  case "$(uname -s)" in
    Darwin) open "$1" >/dev/null 2>&1 ;;
    *) xdg-open "$1" >/dev/null 2>&1 ;;
  esac
  return 0
}

save_token() {
  mkdir -p "$CONFIG_DIR"
  rm -f "$TOKEN_FILE.tmp"
  ( umask 077 && printf '%s\n' "$1" > "$TOKEN_FILE.tmp" )
  chmod 600 "$TOKEN_FILE.tmp"
  mv -f "$TOKEN_FILE.tmp" "$TOKEN_FILE"
}

warn_env_token() {
  [ -z "${FOLDRENDER_TOKEN:-}" ] || note "FOLDRENDER_TOKEN is set, so it is used instead of the saved token"
}

# json_field KEY: the string under KEY in a JSON body (no quotes inside), or
# in a text error's "KEY: value" line.
json_field() {
  { sed -n "s/.*\"$1\" *: *\"\([^\"]*\)\".*/\1/p" "$TMP/body"; sed -n "s/^$1: //p" "$TMP/body"; } | head -n 1 | tr -d '\r'
}

# json_str FILE: FILE's bytes as a JSON string literal. A sentinel byte after
# the content keeps a trailing newline (awk would drop it); control bytes other
# than tab, CR and LF become \u00XX. Bytes above 0x7F pass as they are, so UTF-8
# stays UTF-8.
json_str() {
  # Byte by byte through printf, not gsub: awks (BSD, gawk, busybox) differ on
  # backslashes in a gsub replacement, and agree on string literals.
  { cat "$1"; printf 'X'; } | awk '
    function emit(s,   c) {
      while (match(s, /[\001-\037\\"]/)) {
        c = substr(s, RSTART, 1)
        printf "%s%s", substr(s, 1, RSTART - 1), esc[c]
        s = substr(s, RSTART + 1)
      }
      printf "%s", s
    }
    BEGIN {
      for (i = 1; i < 32; i++) esc[sprintf("%c", i)] = sprintf("\\u%04x", i)
      esc["\t"] = "\\t"; esc["\r"] = "\\r"; esc["\\"] = "\\\\"; esc["\""] = "\\\""
      printf "\""
    }
    NR > 1 { emit(prev); printf "\\n" }
    { prev = $0 }
    END { sub(/X$/, "", prev); emit(prev); printf "\"" }'
}

# field KEY: the value of a key=value line in the body.
field() {
  sed -n "s/^$1=//p" "$TMP/body" | head -n 1 | tr -d '\r'
}

cmd_login() {
  local token=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --token) need $# "$1"; token="$2"; shift 2 ;;
      *) die 2 "unknown option: $1" ;;
    esac
  done
  if [ -n "$token" ]; then
    TOKEN="$token"
    cmd_whoami
    save_token "$token"
    printf 'Token saved to %s\n' "$TOKEN_FILE"
  else
    device_login
  fi
  warn_env_token
}

device_login() {
  local device_code user_code link interval expires pause waited=0 token login
  api POST /api/cli/start -H "Content-Type: application/json" --data '{}'
  expect_2xx
  device_code="$(field device_code)"
  user_code="$(field user_code)"
  link="$(field verification_uri_complete)"
  [ -n "$link" ] || link="$(field verification_uri)"
  interval="$(field interval)"
  expires="$(field expires_in)"
  case "$device_code" in
    ''|*[!A-Za-z0-9_-]*) die 1 "the server did not start a sign-in" ;;
  esac
  pause="${interval:-5}"
  expires="${expires:-900}"

  printf '\nTo sign in, open this page:\n  %s\nand enter this code: %s\n\n' "$link" "$user_code"
  printf 'Waiting for approval...\n'
  open_url "$link"

  while :; do
    [ "$waited" -lt "$expires" ] || die 1 "the code expired before it was approved. Run: foldrender login"
    sleep "$pause"
    waited=$((waited + pause))
    api POST /api/cli/poll -H "Content-Type: application/json" --data "{\"device_code\":\"$device_code\"}"
    if grep -q '^token=' "$TMP/body"; then
      token="$(field token)"
      login="$(field login)"
      [ -n "$token" ] || die 1 "the server returned no token"
      save_token "$token"
      printf 'Signed in as %s. Token saved to %s\n' "${login:-your account}" "$TOKEN_FILE"
      return 0
    fi
    grep -q 'authorization_pending' "$TMP/body" && continue
    if grep -q 'slow_down' "$TMP/body"; then
      pause=$((pause + 5))
      continue
    fi
    grep -q 'expired_token' "$TMP/body" && die 1 "the code expired before it was approved. Run: foldrender login"
    grep -q 'access_denied' "$TMP/body" && die 1 "the sign-in was denied"
    die 1 "unexpected answer from the sign-in server ($(error_text))"
  done
}

cmd_whoami() {
  api_auth GET /api/me
  expect_2xx
  if grep -q '^login=' "$TMP/body"; then
    awk -F= '
      $1 == "login" { l = $2 }
      $1 == "plan" { p = $2 }
      $1 == "used" { u = $2 }
      $1 == "limit" { m = $2 }
      END { printf "signed in as %s (%s plan), %s of %s pages used\n", l, p, u, m }' "$TMP/body"
  else
    cat "$TMP/body"
  fi
}

cmd_logout() {
  rm -f "$TOKEN_FILE"
  printf 'Removed the saved token.\n'
  [ -z "${FOLDRENDER_TOKEN:-}" ] || note "FOLDRENDER_TOKEN is still set in this shell. Unset it to sign out completely."
}

# json_number KEY: the number under KEY in a JSON body.
json_number() {
  sed -n "s/.*\"$1\" *: *\([0-9][0-9]*\).*/\1/p" "$TMP/body" | head -n 1
}

# export [FILE.zip]: every page and a manifest in one zip. The default name is
# foldrender-artifacts-<login>-<date>.zip. Refuses to overwrite.
cmd_export() {
  [ $# -le 1 ] || die 2 "usage: foldrender export [FILE.zip]"
  local target="${1:-}" login=""
  require_token
  if [ -z "$target" ]; then
    api_auth GET /api/me
    expect_2xx
    login="$(field login)"
    [ -n "$login" ] || die 1 "could not read the account login"
    target="foldrender-artifacts-$login-$(date +%Y-%m-%d).zip"
  fi
  [ ! -e "$target" ] || die 1 "$target already exists; choose another name"
  api_auth GET /api/me/export
  expect_2xx
  [ "$(head -c 2 "$TMP/body")" = "PK" ] || die 1 "the server did not return a zip file"
  mkdir -p "$(dirname "$target")"
  cp "$TMP/body" "$target.part" || die 1 "could not write $target"
  mv -f "$target.part" "$target" || die 1 "could not write $target"
  printf '%s\n' "$target"
}

# account delete [--confirm LOGIN]: deletes the account with its pages and API
# tokens, then the saved token and slug map on this machine. Without a terminal
# it needs --confirm LOGIN; at a terminal the user types the login.
cmd_account() {
  [ "${1:-}" = delete ] || die 2 "usage: foldrender account delete [--confirm LOGIN]"
  shift
  local confirm="" typed="" login="" pages="" tokens=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --confirm) need $# "$1"; confirm="$2"; shift 2 ;;
      *) die 2 "unknown option: $1" ;;
    esac
  done
  if [ -n "$confirm" ]; then
    case "$confirm" in
      ''|*[!A-Za-z0-9-]*) die 2 "not a GitHub login: $confirm" ;;
    esac
  else
    [ -t 0 ] || die 2 "refusing to delete the account without a terminal. Re-run with --confirm <your login> if you mean it."
  fi
  require_token
  api_auth GET /api/me
  expect_2xx
  login="$(field login)"
  pages="$(field used)"
  [ -n "$login" ] || die 1 "could not read the account login"
  printf 'Account %s has %s page(s).\nDeleting it removes every page, every API token and the account. It cannot be undone.\nTo keep a copy of your pages first, run: foldrender export\n' "$login" "${pages:-?}" >&2
  if [ -z "$confirm" ]; then
    printf 'Type %s to confirm: ' "$login" >&2
    read -r typed || die 1 "no answer; nothing was deleted"
    confirm="$typed"
  fi
  confirm="$(printf '%s' "$confirm" | tr -d ' \r\t' | tr '[:upper:]' '[:lower:]')"
  [ "$confirm" = "$login" ] || die 1 "the login given does not match $login; nothing was deleted"
  api_auth DELETE "/api/me?confirm=$login"
  if [ "$STATUS" = 403 ]; then
    die 1 "this account cannot be deleted from here: it is the operator's account, or the token is an admin token ($(error_text)). Nothing was deleted."
  fi
  expect_2xx
  pages="$(json_number pages)"
  tokens="$(json_number tokens)"
  rm -f "$TOKEN_FILE" "$SLUG_MAP" "$SLUG_MAP.tmp"
  printf 'Deleted the account %s: %s page(s) and %s API token(s).\n' "$login" "${pages:-?}" "${tokens:-?}"
  printf 'Removed the saved token and the slug map from this machine.\n'
  [ -z "${FOLDRENDER_TOKEN:-}" ] || note "FOLDRENDER_TOKEN is still set in this shell. Unset it to sign out completely."
}

# publish FILE... [options]: each file to its page, one address a line on
# stdout, in order; on stderr one line a page saying what the publish changed.
cmd_publish() {
  local files=() title="" slug="" vis="" share="" name="" folder="" folder_set="" as_json="" f
  while [ $# -gt 0 ]; do
    case "$1" in
      --title) need $# "$1"; title="$2"; shift 2 ;;
      --slug|--id) need $# "$1"; slug="$2"; shift 2 ;;
      --name) need $# "$1"; name="$2"; shift 2 ;;
      --folder) need $# "$1"; folder="$2"; folder_set=1; shift 2 ;;
      --share) need $# "$1"; share="${2// /}"; shift 2 ;;
      --private) vis=private; shift ;;
      --link) vis=link; shift ;;
      --public) vis=public; shift ;;
      --json) as_json=1; shift ;;
      -) files+=("-"); shift ;;
      -*) die 2 "unknown option: $1" ;;
      *) files+=("$1"); shift ;;
    esac
  done
  [ ${#files[@]} -gt 0 ] || die 2 "usage: foldrender publish FILE...|- [--title T] [--name N] [--folder F] [--slug ID] [--private|--link|--public|--share a,b] [--json]"
  if [ ${#files[@]} -gt 1 ]; then
    [ -z "$title$slug$name" ] || die 2 "--title, --name and --slug name one page; publish one file with them"
    for f in "${files[@]}"; do
      [ "$f" != "-" ] || die 2 "publish - takes the page from stdin, so it goes alone"
    done
  fi
  [ -z "$name" ] || check_name "$name" --name
  [ -z "$folder" ] || check_name "$folder" --folder
  if [ -n "$share" ]; then
    [ -z "$vis" ] || die 2 "--share makes the page shared, so drop --private, --link or --public"
    check_logins "$share"
    vis=shared
  fi
  require_token
  for f in "${files[@]}"; do
    publish_one "$f" "$([ ${#files[@]} -gt 1 ] && printf '%s: ' "$f")"
  done
}

# publish_one FILE LABEL: one page, with the options cmd_publish read.
publish_one() {
  local file="$1" label="$2" p_slug="$slug" p_vis="$vis" p_title="$title" mode="" rp="" src="" bytes query
  if [ "$file" = "-" ]; then
    src="$TMP/stdin.html"
    cat > "$src"
  else
    [ -f "$file" ] || die 2 "no such file: $file"
    [ -r "$file" ] || die 2 "cannot read: $file"
    src="$file"
    rp="$(abs_path "$file")" || die 1 "cannot resolve the path of $file"
  fi
  bytes="$(wc -c < "$src" | tr -d ' ')"
  [ "$bytes" -gt 0 ] || die 2 "the page is empty: $file"
  [ "$bytes" -le "$MAX_BYTES" ] || die 5 "$file is $bytes bytes; the limit is 5 MB"
  warn_if_secrets "$src"

  # Which page is this? --slug, then a foldrender-slug meta tag, then the
  # slug this file was published under before.
  if [ -n "$p_slug" ]; then
    page_id "$p_slug"
    p_slug="$PAGE_ID"
    mode=explicit
  else
    p_slug="$(meta_slug "$src")"
    if [ -n "$p_slug" ]; then
      mode=meta
    elif [ -n "$rp" ]; then
      p_slug="$(map_lookup "$rp")"
      [ -z "$p_slug" ] || mode=map
    fi
  fi
  [ -z "$p_slug" ] || check_slug "$p_slug"

  [ -n "$p_title" ] || p_title="$(title_from "$src")"
  # A new page is private unless told otherwise. A re-publish sends only the
  # flags it was given, so the page keeps the visibility and sharing it has.
  # A slug alone does not say which of the two this is: the server makes a new
  # page for a PUT to a slug nobody has, and gives it the server's default. So
  # with no flag, ask first whether the page is one of yours (its version list
  # answers 404 otherwise).
  if [ -n "$p_slug" ] && [ -z "$p_vis" ]; then
    api_auth GET "/api/artifacts/$p_slug/versions"
    case "$STATUS" in
      200) ;;
      404)
        p_vis=private
        if [ "$mode" = map ]; then
          note "${label}the page $p_slug was deleted, so this publish made a new one"
          map_forget 1 "$rp"
          p_slug=""
        fi
        ;;
      *) fail_http ;;
    esac
  fi
  if [ -z "$p_slug" ] && [ -z "$p_vis" ]; then
    p_vis=private
  fi
  query=""
  [ -z "$p_title" ] || query="title=$(urlencode "$p_title")"
  [ -z "$p_vis" ] || query="${query:+$query&}visibility=$p_vis"
  [ -z "$share" ] || query="${query:+$query&}share=$share"
  [ -z "$name" ] || query="${query:+$query&}name=$name"
  [ -z "$folder_set" ] || query="${query:+$query&}folder=$folder"

  [ -z "$as_json" ] || ACCEPT="application/json"
  if [ -n "$p_slug" ]; then
    upload PUT "/api/artifacts/$p_slug" "$src" "$query"
  else
    upload POST /api/artifacts "$src" "$query"
  fi
  if [ "$STATUS" = 404 ] && [ "$mode" = map ]; then
    note "${label}the page $p_slug was deleted, so this publish made a new one"
    map_forget 1 "$rp"
    upload POST /api/artifacts "$src" "$query"
  fi
  if [ "$STATUS" = 404 ] && [ "$mode" = explicit ]; then
    die 1 "there is no page named $p_slug"
  fi
  if [ "$STATUS" = 404 ] && [ "$mode" = meta ]; then
    die 1 "there is no page named $p_slug (from the foldrender-slug meta tag). Change or remove the tag."
  fi
  if [ "$STATUS" = 409 ]; then
    die 1 "another of your pages is already at that address (${name:+name $name}${folder:+, folder $folder}). Choose another with --name or --folder"
  fi
  expect_2xx
  if [ -n "$as_json" ]; then
    ACCEPT="text/plain"
    PAGE_ID="$(json_field id)"
    PAGE_URL="$(json_field url)"
    [ -n "$PAGE_ID" ] || die 1 "the server did not say which page it wrote ($(error_text))"
    cat "$TMP/body"
    printf '\n'
  else
    read_page_url
  fi
  if [ -n "$rp" ]; then
    map_set "$rp" "$PAGE_ID"
  fi
  # A new page whose name another of the owner's pages holds is given name-2.
  if [ -n "$name" ]; then
    case "$(slug_from "$PAGE_URL")" in
      "$name"|"$PAGE_ID") ;;
      *) note "${label}the name $name is taken by another of your pages, so this one is at $(slug_from "$PAGE_URL"). Choose another with --name" ;;
    esac
  fi
  [ -n "$as_json" ] && return 0
  printf '%s\n' "$PAGE_URL"
  publish_note "$label"
}

# What a write changed, from the rev=, changed=, added= and removed= lines of
# its answer, as one note. A server from before revisions sends none: no note.
publish_note() {
  local rev
  rev="$(field rev)"
  [ -n "$rev" ] || return 0
  if [ "$(field changed)" = 0 ]; then
    note "${1}unchanged, rev $rev"
  elif [ "$rev" = 1 ]; then
    note "${1}new page, rev 1"
  else
    note "${1}rev $rev: +$(field added) -$(field removed) lines"
  fi
}

# edit PAGE --old TEXT --new TEXT [...]: exact replacements in the page's HTML,
# made by the server, so only the changes are sent. Each --old must be in the
# page exactly once, as the edits before it left it. --edits FILE (or -) reads
# them as JSON: an array of {"old": ..., "new": ...}, or the request's object.
# --base REV refuses to edit a page that has moved on from that revision.
cmd_edit() {
  local target="" base="" title="" efile="" n=0 have_old="" as_json="" c
  : > "$TMP/edits.json"
  while [ $# -gt 0 ]; do
    case "$1" in
      --old)
        need $# "$1"
        [ -z "$have_old" ] || die 2 "--old $((n + 1)) has no --new after it"
        printf '%s' "$2" > "$TMP/old"
        have_old=1
        shift 2 ;;
      --new)
        need $# "$1"
        [ -n "$have_old" ] || die 2 "--new needs an --old before it"
        printf '%s' "$2" > "$TMP/new"
        [ "$n" -eq 0 ] || printf ',' >> "$TMP/edits.json"
        { printf '{"old":'; json_str "$TMP/old"; printf ',"new":'; json_str "$TMP/new"; printf '}'; } >> "$TMP/edits.json"
        n=$((n + 1))
        have_old=""
        shift 2 ;;
      --edits) need $# "$1"; efile="$2"; shift 2 ;;
      --base)
        need $# "$1"
        case "$2" in ''|*[!0-9]*) die 2 "--base takes a revision number (see: foldrender versions PAGE)" ;; esac
        base="$2"; shift 2 ;;
      --title) need $# "$1"; title="$2"; shift 2 ;;
      --json) as_json=1; shift ;;
      -*) die 2 "unknown option: $1" ;;
      *) [ -z "$target" ] || die 2 "edit takes one page"; target="$1"; shift ;;
    esac
  done
  [ -z "$have_old" ] || die 2 "the last --old has no --new after it"
  [ -n "$target" ] || die 2 "usage: foldrender edit PAGE --old TEXT --new TEXT [--old ... --new ...] [--base REV] | --edits FILE"
  [ "$n" -gt 0 ] || [ -n "$efile" ] || die 2 "nothing to change: give --old TEXT --new TEXT, or --edits FILE"
  [ "$n" -eq 0 ] || [ -z "$efile" ] || die 2 "--edits and --old/--new do not go together"
  require_token
  page_id "$target"
  check_slug "$PAGE_ID"
  if [ -n "$efile" ]; then
    if [ "$efile" = - ]; then
      cat > "$TMP/efile"
    else
      [ -f "$efile" ] || die 2 "no such file: $efile"
      cp "$efile" "$TMP/efile"
    fi
    c="$(tr -d ' \t\r\n' < "$TMP/efile" | head -c 1)"
    case "$c" in
      '[') { printf '{"edits":'; cat "$TMP/efile"; } > "$TMP/edit.json" ;;
      '{') [ -z "$base$title" ] || die 2 "the --edits object carries its own base and title; drop --base and --title"
           cp "$TMP/efile" "$TMP/edit.json" ;;
      *) die 2 "--edits takes JSON: an array of {\"old\": ..., \"new\": ...}, or an object with edits" ;;
    esac
  else
    { printf '{"edits":['; cat "$TMP/edits.json"; printf ']'; } > "$TMP/edit.json"
  fi
  if [ "$c" != '{' ]; then
    [ -z "$base" ] || printf ',"base":%s' "$base" >> "$TMP/edit.json"
    if [ -n "$title" ]; then
      printf '%s' "$title" > "$TMP/title"
      { printf ',"title":'; json_str "$TMP/title"; } >> "$TMP/edit.json"
    fi
    printf '}' >> "$TMP/edit.json"
  fi
  [ -z "$as_json" ] || ACCEPT="application/json"
  api_auth POST "/api/artifacts/$PAGE_ID/edit" -H "Content-Type: application/json" --data-binary "@$TMP/edit.json"
  case "$STATUS" in
    404) die 7 "no page named $PAGE_ID among yours" ;;
    409)
      [ -z "$(json_field message)" ] || die 10 "$(json_field message)"
      die 10 "the edit did not apply ($(error_text))" ;;
  esac
  expect_2xx
  if [ -n "$as_json" ]; then
    cat "$TMP/body"
    printf '\n'
    return 0
  fi
  read_page_url
  printf '%s\n' "$PAGE_URL"
  publish_note ""
}

# versions PAGE: the page's revision and the versions it kept, newest first,
# each with the id restore takes.
cmd_versions() {
  local target="" as_json=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) as_json=1; shift ;;
      -*) die 2 "unknown option: $1" ;;
      *) [ -z "$target" ] || die 2 "versions takes one page"; target="$1"; shift ;;
    esac
  done
  [ -n "$target" ] || die 2 "usage: foldrender versions PAGE [--json]"
  require_token
  page_id "$target"
  check_slug "$PAGE_ID"
  [ -z "$as_json" ] || ACCEPT="application/json"
  api_auth GET "/api/artifacts/$PAGE_ID/versions"
  [ "$STATUS" != 404 ] || die 7 "no page named $PAGE_ID among yours"
  expect_2xx
  if [ -n "$as_json" ] || [ "$(head -c 1 "$TMP/body")" = "{" ]; then
    cat "$TMP/body"
    printf '\n'
    return 0
  fi
  awk -F'\t' -v page="$target" '
    NR == 1 { sub(/^rev=/, ""); printf "%s is at rev %s\n", page, $0; next }
    { d = $2; sub(/T/, " ", d); printf "%s  %s  %7.1f KB  %s\n", $1, substr(d, 1, 16), $3 / 1024, $4 }
    END {
      if (NR <= 1) print "no earlier versions"
      else printf "put one back: foldrender restore %s VERSION (or foldrender undo %s for the newest)\n", page, page
    }' "$TMP/body"
}

# restore PAGE VERSION: that version becomes the page again; the body it
# replaces is kept as a version, so a restore can be undone.
cmd_restore() {
  [ $# -eq 2 ] || die 2 "usage: foldrender restore PAGE VERSION (see: foldrender versions PAGE)"
  require_token
  page_id "$1"
  check_slug "$PAGE_ID"
  case "$2" in
    ''|*[!0-9a-f]*) die 2 "not a version id: $2 (see: foldrender versions $1)" ;;
  esac
  restore_version "$1" "$2"
}

restore_version() {
  api_auth POST "/api/artifacts/$PAGE_ID/versions/$2/restore"
  [ "$STATUS" != 404 ] || die 7 "no version $2 of $1 (see: foldrender versions $1)"
  expect_2xx
  read_page_url
  printf '%s\n' "$PAGE_URL"
  note "restored version $2${PAGE_ID:+ of $PAGE_ID}$( [ -n "$(field rev)" ] && printf ' as rev %s' "$(field rev)")"
}

# undo PAGE: puts back the newest version kept, the body before the current
# one. The current body is kept in turn, so undo twice is back where it was.
cmd_undo() {
  [ $# -eq 1 ] || die 2 "usage: foldrender undo PAGE"
  local vid
  require_token
  page_id "$1"
  check_slug "$PAGE_ID"
  api_auth GET "/api/artifacts/$PAGE_ID/versions"
  [ "$STATUS" != 404 ] || die 7 "no page named $PAGE_ID among yours"
  expect_2xx
  vid="$(sed -n '2p' "$TMP/body" | cut -f1)"
  case "$vid" in
    ''|*[!0-9a-f]*) die 1 "$1 has no earlier version to go back to" ;;
  esac
  restore_version "$1" "$vid"
}

cmd_share() {
  local targets=() vis="" adds="" removes="" arg json reset="" as_json="" t
  for arg in "$@"; do
    case "$arg" in
      --public) vis=public ;;
      --link) vis=link ;;
      --private) vis=private ;;
      --reset-link) reset=1 ;;
      --json) as_json=1 ;;
      --*) die 2 "unknown option: $arg" ;;
      +?*) check_logins "${arg#+}"; adds="${adds:+$adds,}${arg#+}" ;;
      -?*) check_logins "${arg#-}"; removes="${removes:+$removes,}${arg#-}" ;;
      ?*) targets+=("$arg") ;;
      *) die 2 "expected a page, +login, -login, --public, --link, --private or --reset-link" ;;
    esac
  done
  [ ${#targets[@]} -gt 0 ] || die 2 "usage: foldrender share PAGE... [+login ...] [-login ...] [--public|--link|--private] [--reset-link]"
  [ -n "$adds$removes$vis$reset" ] || die 2 "nothing to change: give +login, -login, --public, --link, --private or --reset-link"

  json=""
  [ -z "$vis" ] || json="\"visibility\":\"$vis\""
  [ -z "$reset" ] || json="${json:+$json,}\"reset_link\":true"
  [ -z "$adds" ] || json="${json:+$json,}\"share_add\":$(json_array "$adds")"
  [ -z "$removes" ] || json="${json:+$json,}\"share_remove\":$(json_array "$removes")"
  [ -z "$as_json" ] || ACCEPT="application/json"
  for t in "${targets[@]}"; do
    page_id "$t"
    check_slug "$PAGE_ID"
    api_auth PATCH "/api/artifacts/$PAGE_ID" -H "Content-Type: application/json" --data "{$json}"
    [ "$STATUS" != 404 ] || die 7 "no page named $PAGE_ID among yours"
    expect_2xx
    if [ -n "$as_json" ]; then
      cat "$TMP/body"
      printf '\n'
    else
      read_page_url
      printf '%s\n' "$PAGE_URL"
    fi
  done
}

# ls [WORDS...]: your pages, newest first, one line each: the newest 20 unless
# --all or -n N. WORDS must all be in the id, title or address (any case);
# --access keeps one kind, --folder one folder; --long adds each address.
cmd_list() {
  local words="" limit=20 access="" folder="" long="" as_json=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --all|-a) limit=0; shift ;;
      -n) need $# "$1"; case "$2" in ''|*[!0-9]*) die 2 "-n takes a number" ;; esac; limit="$2"; shift 2 ;;
      --access|--vis|--visibility)
        need $# "$1"
        case "$2" in public|link|private|shared) access="$2" ;; *) die 2 "$1 takes public, link, private or shared" ;; esac
        shift 2 ;;
      --folder) need $# "$1"; check_name "$2" --folder; folder="$2"; shift 2 ;;
      --long|-l) long=1; shift ;;
      --json) as_json=1; shift ;;
      -*) die 2 "unknown option: $1" ;;
      *) words="$words $1"; shift ;;
    esac
  done
  if [ -n "$as_json" ]; then
    ACCEPT="application/json"
    api_auth GET /api/artifacts
    expect_2xx
    cat "$TMP/body"
    printf '\n'
    return 0
  fi
  api_auth GET /api/artifacts
  expect_2xx
  if [ ! -s "$TMP/body" ]; then
    printf 'No pages yet.\n'
    return 0
  fi
  # The list: id, access, updated (ISO), expires or "-", title, address.
  awk -F'\t' -v words="$words" -v access="$access" -v folder="$folder" -v limit="$limit" -v long="$long" '
    BEGIN { nw = split(tolower(words), w, " ") }
    {
      hay = tolower($1 " " $5 " " $6)
      for (i = 1; i <= nw; i++) if (index(hay, w[i]) == 0) next
      if (access != "" && $2 != access) next
      if (folder != "" && index($6, "/" folder "/") == 0) next
      n++
      if (limit > 0 && n > limit) next
      id[n] = $1; acc[n] = $2; t[n] = $5; addr[n] = $6
      up[n] = substr($3, 1, 10) " " substr($3, 12, 5)
      ex[n] = ($4 != "-" && $4 != "") ? "  (expires " substr($4, 1, 10) ")" : ""
      if (length($1) > wid) wid = length($1)
    }
    END {
      shown = (limit > 0 && n > limit) ? limit : n
      if (shown == 0) { print (NR ? "No page matches." : "No pages yet."); exit }
      printf "%-" wid "s  %-7s  %-16s  %s\n", "ID", "ACCESS", "UPDATED (UTC)", "TITLE"
      for (i = 1; i <= shown; i++) {
        printf "%-" wid "s  %-7s  %-16s  %s%s\n", id[i], acc[i], up[i], t[i], ex[i]
        if (long != "" && addr[i] != "" && addr[i] != "-") printf "%-" wid "s  %s\n", "", addr[i]
      }
      if (n > shown) printf "%d more: foldrender ls --all, or narrow it: foldrender ls WORDS\n", n - shown
    }' "$TMP/body"
}

cmd_rm() {
  [ $# -ge 1 ] || die 2 "usage: foldrender rm PAGE..."
  local t failed=0
  for t in "$@"; do
    case "$t" in -*) die 2 "unknown option: $t" ;; esac
  done
  for t in "$@"; do
    page_id "$t"
    check_slug "$PAGE_ID"
    api_auth DELETE "/api/artifacts/$PAGE_ID"
    if [ "$STATUS" = 404 ]; then
      map_forget 2 "$PAGE_ID"
      note "not found: $PAGE_ID"
      failed=1
      continue
    fi
    expect_2xx
    map_forget 2 "$PAGE_ID"
    printf 'removed %s\n' "$PAGE_ID"
  done
  [ "$failed" = 0 ] || exit 1
}

# open ID|URL: prints the page's address and opens it. An id, or a link by id,
# is looked up (format=meta, the facts without the page) for its address; an
# address is used as it is.
cmd_open() {
  [ $# -eq 1 ] || die 2 "usage: foldrender open <slug-or-url>"
  local url=""
  case "$1" in
    http://*/artifacts/-/*|https://*/artifacts/-/*) ;;
    http://*/artifacts/*|https://*/artifacts/*) url="$1" ;;
  esac
  if [ -z "$url" ]; then
    page_id "$1"
    check_slug "$PAGE_ID"
    read_get "/api/artifacts/$PAGE_ID?format=meta"
    [ "$STATUS" = 200 ] || read_fail "$PAGE_ID"
    url="$(sed -n 's/^url: *//p' "$TMP/body" | head -n 1 | tr -d '\r"')"
    case "$url" in
      http*) ;;
      *) die 1 "the server did not say where $PAGE_ID is" ;;
    esac
  fi
  printf '%s\n' "$url"
  open_url "$url"
}

#   ------------------------------------------------------------------ read


# read_get PATH: a GET on the read API, with the token when there is one, and
# the page's link token when its address carried one (PAGE_K). Public pages
# need neither, so a missing token is not an error here.
read_get() {
  local path="$1"
  if [ -n "${PAGE_K:-}" ]; then
    case "$path" in
      *\?*) path="$path&k=$PAGE_K" ;;
      *) path="$path?k=$PAGE_K" ;;
    esac
  fi
  if [ -n "$TOKEN" ]; then
    api GET "$path" -H "$(auth_header)"
  else
    api GET "$path"
  fi
}

# read_fail SLUG: the error for a read that did not answer 200.
read_fail() {
  local msg
  msg="$(error_text)"
  case "$STATUS" in
    401)
      [ -z "$TOKEN" ] || die 3 "the token was rejected ($msg). Run: foldrender login"
      die 3 "$1 is not public. Sign in to read it: foldrender login" ;;
    404)
      [ -z "$TOKEN" ] || die 7 "no page named $1, or it is not shared with the account you are signed in as (see: foldrender whoami)"
      die 7 "no page named $1. If it is private or shared, sign in first: foldrender login" ;;
    410) die 8 "$msg" ;;
    413) die 9 "$1 is too large to read as text ($msg). Read its HTML instead: foldrender read $1 --html" ;;
    400) die 2 "$msg" ;;
  esac
  fail_http
}

# Escapes a string for the replacement side of a sed s|||.
sed_escape() {
  printf '%s' "$1" | sed 's/[\\&|]/\\&/g'
}

# save_assets SLUG DIR MODE: saves the page's embedded images and inline SVG
# into DIR, reports each path on stderr and, for the text output, points the
# asset:N references at the saved files.
save_assets() {
  local slug="$1" dir="$2" mode="$3" n name type size label path count=0
  read_get "/api/artifacts/$slug/assets"
  [ "$STATUS" = 200 ] || read_fail "$slug"
  cp "$TMP/body" "$TMP/assets"
  if [ ! -s "$TMP/assets" ]; then
    note "the page has no embedded images or SVG to save"
    return 0
  fi
  mkdir -p "$dir" || die 1 "cannot create $dir"
  : > "$TMP/rewrite.sed"
  while IFS="$(printf '\t')" read -r n name type size label <&3; do
    case "$n" in ''|*[!0-9]*) continue ;; esac
    case "$name" in ''|*/*|.*) continue ;; esac
    read_get "/api/artifacts/$slug/assets/$n"
    [ "$STATUS" = 200 ] || read_fail "$slug"
    path="${dir%/}/$name"
    cp "$TMP/body" "$path" || die 1 "could not write $path"
    note "saved $path ($type, $size bytes)${label:+: $label}"
    printf 's|(asset:%s)|(%s)|g\ns|\\[SVG asset:%s\\([]:]\\)|[SVG %s\\1|g\n' \
      "$n" "$(sed_escape "$path")" "$n" "$(sed_escape "$path")" >> "$TMP/rewrite.sed"
    count=$((count + 1))
  done 3< "$TMP/assets"
  if [ "$mode" = text ] && [ "$count" -gt 0 ]; then
    sed -f "$TMP/rewrite.sed" "$TMP/page" > "$TMP/page.new" && mv -f "$TMP/page.new" "$TMP/page"
  fi
}

# read SLUG|URL: the page as Markdown after a few facts about it, stopping
# near FOLDRENDER_READ_MAX_TOKENS (6000) with how much is left, the command
# that goes on, and the page's sections. --outline lists the headings with their sizes, --section N (or
# a heading's text) reads one, --from N goes on where a read stopped, --max-tokens
# and --max-chars set the stop, --all reads everything, --meta full gives every
# fact. --html prints the stored HTML, --json the API's JSON, --save FILE writes
# the stored HTML to a file, --assets DIR also saves embedded images and SVG. A
# PDF published from the app reads as its text, page by page; its page images
# are the assets.
cmd_read() {
  local target="" mode=text assets="" save="" slug query="" part="" outline="" cut=""
  local maxt="${FOLDRENDER_READ_MAX_TOKENS:-6000}" meta=short
  case "$maxt" in ''|*[!0-9]*) maxt=6000 ;; esac
  while [ $# -gt 0 ]; do
    case "$1" in
      --html) mode=html; shift ;;
      --json) mode=json; shift ;;
      --assets) need $# "$1"; assets="$2"; shift 2 ;;
      --save|-o) need $# "$1"; save="$2"; shift 2 ;;
      --outline) outline=1; cut=1; shift ;;
      --section) need $# "$1"; part="$part&section=$(urlencode "$2")"; cut=1; shift 2 ;;
      --from)
        need $# "$1"
        case "$2" in ''|*[!0-9]*) die 2 "--from takes a character offset, from the next: line of a read that stopped" ;; esac
        part="$part&from=$2"; cut=1; shift 2 ;;
      --max-tokens)
        need $# "$1"
        case "$2" in ''|*[!0-9]*) die 2 "--max-tokens takes a number (0: no limit)" ;; esac
        maxt="$2"; cut=1; shift 2 ;;
      --max-chars)
        need $# "$1"
        case "$2" in ''|*[!0-9]*|0) die 2 "--max-chars takes a number above 0" ;; esac
        part="$part&max_chars=$2"; maxt=0; cut=1; shift 2 ;;
      --all) maxt=0; shift ;;
      --meta)
        need $# "$1"
        case "$2" in short|full) meta="$2" ;; *) die 2 "--meta takes short or full" ;; esac
        shift 2 ;;
      -*) die 2 "unknown option: $1" ;;
      *) [ -z "$target" ] || die 2 "read takes one page"; target="$1"; shift ;;
    esac
  done
  [ -n "$target" ] || die 2 "usage: foldrender read PAGE [--outline|--section N|--from N] [--max-tokens N|--max-chars N|--all] [--meta full] [--html|--json|--save FILE] [--assets DIR]"
  [ -z "$save" ] || [ "$mode" = text ] || die 2 "--save writes the stored file; drop --html or --json"
  [ -z "$save" ] || [ -z "$assets" ] || die 2 "--save and --assets do not go together"
  [ -z "$cut" ] || { [ "$mode" != html ] && [ -z "$save" ]; } || die 2 "--outline, --section, --from and --max-* cut the Markdown; drop --html or --save"
  # read never requests the URL itself: a private page's link redirects to the
  # content host, where a client without a cookie jar loses the token and is
  # sent back, round and round. An address is resolved to its id instead.
  page_id "$target"
  slug="$PAGE_ID"
  check_slug "$slug"
  case "$slug" in
    a|api|artifacts|auth|cli) die 2 "$target is not a link to a page" ;;
  esac

  if [ -n "$save" ]; then
    [ ! -e "$save" ] || die 1 "$save already exists; choose another name"
    read_get "/api/artifacts/$slug?format=raw"
    [ "$STATUS" = 200 ] || read_fail "$slug"
    cp "$TMP/body" "$save.part" 2>/dev/null && mv -f "$save.part" "$save" || die 1 "could not write $save"
    printf '%s\n' "$save"
    return 0
  fi

  if [ "$mode" = html ]; then
    query="?format=html"
  else
    query="meta=$meta"
    [ -n "$outline" ] && query="$query&outline=1"
    [ -z "$outline" ] && [ "$maxt" != 0 ] && query="$query&max_tokens=$maxt"
    query="?$query$part"
  fi
  [ "$mode" != json ] || ACCEPT="application/json"
  read_get "/api/artifacts/$slug$query"
  ACCEPT="text/plain"
  [ "$STATUS" = 200 ] || read_fail "$slug"
  cp "$TMP/body" "$TMP/page"
  [ -z "$assets" ] || save_assets "$slug" "$assets" "$mode"
  cat "$TMP/page"
}

cmd_help() {
  case "${1:-}" in
    '') cat <<'EOF'
foldrender publishes HTML pages as links and reads pages back as text.

  publish FILE...      publish (or update) pages; prints each address
  edit PAGE            change part of a page: --old TEXT --new TEXT
  read PAGE            the page as Markdown; a long page stops at ~6k tokens,
                       lists its sections and says how to go on (--section N)
  ls [WORDS]           your newest 20 pages (--all, --access A, --folder F)
  share PAGE...        +login -login --public --link --private --reset-link
  versions PAGE        kept versions; restore PAGE VERSION; undo PAGE
  rm PAGE...           delete pages
  open PAGE            print the page's address and open it
  login / logout / whoami / export [FILE] / account delete

PAGE is a page's address, its id, or an old a.foldrender.dev link.
--json prints the API's answer. More: foldrender help COMMAND, help exit.
EOF
    ;;
    publish) cat <<'EOF'
foldrender publish FILE...|- [options]
  Publishes each file and prints its address, one line a page. Publishing the
  same file again updates the same page; stderr says the revision and the lines
  added and removed, or "unchanged" (nothing is written then).
  --private            only you (the default for a new page)
  --link               anyone with the link; the link carries a key (?k=)
  --public             anyone, and listed on your page .../artifacts/LOGIN/
  --share a,b          only these GitHub logins
  --name NAME          the address's last part (default: from the title)
  --folder FOLDER      .../artifacts/LOGIN/FOLDER/NAME
  --title TEXT         the title (default: the file's <title>)
  --slug ID|ADDRESS    publish to that page
  --json               the API's answer, one JSON object a page
Examples: foldrender publish report.html --link
          foldrender publish a.html b.html c.html --folder q3
EOF
    ;;
    edit) cat <<'EOF'
foldrender edit PAGE --old TEXT --new TEXT [--old TEXT --new TEXT ...] [--base REV] [--title T]
foldrender edit PAGE --edits FILE|-    (JSON: [{"old": "...", "new": "..."}, ...])
  Replaces each --old with its --new in the page's HTML, in order, on the
  server: only the changes are sent. Each --old must be in the page exactly
  once (as the edits before it left it), or nothing changes (exit 10).
  --base REV refuses if the page is no longer at that revision (exit 10).
  Prints the address; stderr says the new revision and the lines changed.
EOF
    ;;
    read) cat <<'EOF'
foldrender read PAGE [options]
  A few facts (title, address, id, updated, size), then the page as Markdown.
  A long page stops near 6k tokens (FOLDRENDER_READ_MAX_TOKENS) and ends with
  how much is left, the command that goes on, and its sections by number.
  --outline            the headings, numbered, each with its size
  --section N|TEXT     one section (its number in the outline, or its heading)
  --from N             go on from character N (the next: line says which)
  --max-tokens N       stop near N tokens; --max-chars N near N characters
  --all                no stop
  --meta full          every fact (owner, access, sharing, expiry, type)
  --json               the API's JSON; --html the stored HTML
  --save FILE          save the stored HTML; --assets DIR save images and SVG
EOF
    ;;
    ls|list) cat <<'EOF'
foldrender ls [WORDS...] [--all|-n N] [--access public|link|private|shared] [--folder F] [--long] [--json]
  Your pages, newest first: the 20 newest unless --all or -n N. WORDS must all
  be in the id, title or address. --long adds each page's address.
EOF
    ;;
    share) cat <<'EOF'
foldrender share PAGE... [+LOGIN ...] [-LOGIN ...] [--public|--link|--private] [--reset-link]
  Changes who can read the pages, without publishing them again; prints each
  address. --reset-link gives a --link page a new key: the old link stops working.
EOF
    ;;
    versions|restore|undo) cat <<'EOF'
foldrender versions PAGE       the page's revision and the versions it kept, newest first
foldrender restore PAGE VERSION   put a version back (the current body is kept in turn)
foldrender undo PAGE           put back the newest kept version; undo again to return
EOF
    ;;
    exit) cat <<'EOF'
Exit codes: 0 ok, 1 failed, 2 bad usage, 3 not signed in or token rejected,
4 plan limit reached, 5 page too large, 6 network failure, 7 no such page or
not visible to this account, 8 page expired, 9 too large to read as text
(use --html), 10 an edit did not apply (old text missing or not unique, or
the page moved on from --base).
Environment: FOLDRENDER_TOKEN (a token instead of the saved login),
FOLDRENDER_API (the API, for testing), FOLDRENDER_NO_BROWSER=1,
FOLDRENDER_READ_MAX_TOKENS. Free plan: 10 pages, 30 days each, 5 MB a page.
EOF
    ;;
    *) die 2 "no help for $1; try: foldrender help" ;;
  esac
}

main() {
  local cmd="${1:-help}"
  [ $# -eq 0 ] || shift
  case "$cmd" in
    login) cmd_login "$@" ;;
    logout) cmd_logout ;;
    account) cmd_account "$@" ;;
    export) cmd_export "$@" ;;
    whoami) cmd_whoami ;;
    publish) cmd_publish "$@" ;;
    edit) cmd_edit "$@" ;;
    share) cmd_share "$@" ;;
    list|ls) cmd_list "$@" ;;
    read|cat) cmd_read "$@" ;;
    versions) cmd_versions "$@" ;;
    restore) cmd_restore "$@" ;;
    undo) cmd_undo "$@" ;;
    rm|delete) cmd_rm "$@" ;;
    open) cmd_open "$@" ;;
    help|-h|--help) cmd_help "$@" ;;
    *) die 2 "unknown command: $cmd (try: foldrender help)" ;;
  esac
}

TOKEN="$(read_token)"
main "$@"
