        desk2_fail
      fi
      [ "$mode" = json ] && { cat "$TMP/body"; printf '\n'; return 0; }
      marked="$(sed -n 's/.*"marked":\[\([^]]*\)\].*/\1/p' "$TMP/body" | tr -d '"')"
      unchanged="$(sed -n 's/.*"unchanged":\[\([^]]*\)\].*/\1/p' "$TMP/body" | tr -d '"')"
      if [ -n "$marked" ] && [ -n "$correct" ]; then printf 'batch %s: %s corrected to %s\n' "$batch" "$marked" "$st"
      elif [ -n "$marked" ]; then printf 'batch %s: %s marked %s\n' "$batch" "$marked" "$st"; fi
      if [ -n "$unchanged" ]; then
        if grep -q '"hint"' "$TMP/body"; then printf 'batch %s: %s unchanged (marked already, with another result: the one who marked it changes it with --correct)\n' "$batch" "$unchanged"
        else printf 'batch %s: %s unchanged (marked so already)\n' "$batch" "$unchanged"; fi
      fi
      ;;
    batches)
      local limit=""
      while [ $# -gt 0 ]; do
        case "$1" in
          --limit) need $# "$1"; case "$2" in ''|*[!0-9]*) die 2 "--limit is a number" ;; esac; limit="$2"; shift 2 ;;
          *) die 2 "desk batches [--limit N] [--json]" ;;
        esac
      done
      [ "$mode" = json ] && ACCEPT="application/json" || ACCEPT="text/plain"
      desk2_api GET "/batches${limit:+?limit=$limit}"
      [ "${STATUS#2}" != "$STATUS" ] || desk2_fail
      cat "$TMP/body"
      [ "$mode" != json ] || printf '\n'
      ;;
    *) die 2 "unknown desk command: $sub (foldrender help desk)" ;;
  esac
}

# A machine's name on the desk: 1 to 32 letters, digits, dots, underscores and
# hyphens, starting with a letter or a digit.
check_machine_name() {
  case "$1" in
    ''|[!A-Za-z0-9]*|*[!A-Za-z0-9._-]*) die 2 "a machine's name is letters, digits, . _ and -, starting with a letter or digit: $1" ;;
  esac
  [ "${#1}" -le 32 ] || die 2 "a machine's name is at most 32 characters: $1"
}

# This computer's name, as a machine's name: its short host name, with what a
# machine's name cannot hold made a hyphen.
default_machine_name() {
  local n
  n="$(hostname -s 2>/dev/null || hostname 2>/dev/null || printf 'machine')"
  n="$(printf '%s' "$n" | tr -c 'A-Za-z0-9._-' '-' | cut -c 1-32)"
  while :; do case "$n" in [!A-Za-z0-9]*) n="${n#?}" ;; *) break ;; esac; done
  printf '%s' "${n:-machine}"
}

# machine_add NAME [REPLACE]: a new machine on the desk, its token in the body
# ($TMP/body, this run's private folder).
machine_add() {
  printf '{"name":%s%s}' "$(json_arg "$1")" "${2:+,\"replace\":true}" > "$TMP/req"
  ACCEPT="application/json"
  api_auth POST "/api/desk/machines" -H "Content-Type: application/json" --data-binary "@$TMP/req"
  ACCEPT="text/plain"
  case "$STATUS" in
    201|200) grep -q '"token" *: *"frdm_' "$TMP/body" || die 1 "the desk made machine $1 but sent no token" ;;
    409) die 1 "the desk has a machine named $1 already (id $(json_get str id 2>/dev/null || printf '?')); --replace gives it a new token and revokes the old one" ;;
    403) if grep -q '"full"' "$TMP/body"; then die 4 "$(error_text)"; fi; fail_http ;;
    400) die 2 "$(error_text)" ;;
    404) die 1 "this account has no desk with machines ($(error_text))" ;;
    *) fail_http ;;
  esac
}

# foldrender desk machine add NAME [--replace] | ls | rm ID: the machines that
# report what runs on them to the desk, each with a token of its own (frdm_...)
# that can do nothing but that. add prints the token once, alone on stdout.
# A picture a question may show (<api>/desk/images): the file's bytes, its type
# by its name; prints the image's id (its SHA-256) for the card's images.
cmd_desk_image() {
  local file="" mode=text type size
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) mode=json; shift ;;
      -*) die 2 "desk image FILE [--json]" ;;
      *) [ -z "$file" ] || die 2 "desk image takes one FILE"; file="$1"; shift ;;
    esac
  done
  [ -n "$file" ] || die 2 "which picture? foldrender desk image FILE (a PNG, JPEG or WebP, at most 200 KB)"
  desk_image_check "$file"
  desk_image_put "$file"
  [ "$mode" = json ] && { cat "$TMP/body"; printf '\n'; return 0; }
  json_get str id
  printf '\n'
  note "put it in a question: \"images\": [{\"id\": \"<that id>\", \"label\": \"A ...\"}] (at most 3), or let desk card --image FILE=LABEL do both"
}

# desk_image_check FILE: a picture the desk may take (its name and size), or
# exit 2 before anything is sent. desk_image_put FILE: sends it; the answer
# ({id, ...}) is in $TMP/body.
# --image FILE[=LABEL]: sets ifile and ilabel (the caller's). A file that is
# there is the whole argument, whatever it holds; otherwise it is split at the
# first =, and only when there is one (a missing FILE alone is said to be
# missing, not taken for a label).
desk_image_arg() {
  ifile="$1"; ilabel=""
  case "$1" in *=*) [ -f "$1" ] || { ifile="${1%%=*}"; ilabel="${1#*=}"; } ;; esac
}

desk_image_check() {
  local file="$1" size
  [ -f "$file" ] && [ -r "$file" ] || die 2 "cannot read $file"
  case "$(printf '%s' "$file" | tr '[:upper:]' '[:lower:]')" in
    *.png|*.jpg|*.jpeg|*.webp) ;;
    *) die 2 "a question's picture is a .png, .jpg or .webp file (an SVG is not taken: export it as a PNG)" ;;
  esac
  size="$(wc -c < "$file" | tr -d ' ')"
  [ "$size" -le 204800 ] || die 2 "$file is $((size / 1024)) KB: a question's picture is at most 200 KB (make it smaller first)"
}
desk_image_put() {
  local file="$1" type
  case "$(printf '%s' "$file" | tr '[:upper:]' '[:lower:]')" in
    *.png) type=image/png ;;
    *.jpg|*.jpeg) type=image/jpeg ;;
    *.webp) type=image/webp ;;
  esac
  ACCEPT="application/json"
  api POST "/api/desk/images" -H "$(desk_auth)" -H "Content-Type: $type" --data-binary "@$file"
  ACCEPT="text/plain"
  case "$STATUS" in
    2??) ;;
    401) die 3 "not signed in, or the token was rejected ($(error_text))" ;;
    403) die 1 "$(error_text)" ;;
    404) die 7 "no desk for this account (foldrender desk init makes one)" ;;
    413) die 1 "the desk takes a picture of at most 200 KB" ;;
    415) die 1 "$file is not a PNG, JPEG or WebP inside" ;;
    429) die 1 "$(error_text)" ;;
    *) fail_http ;;
  esac
}

# What the desk calls its owner (<api>/desk/owner): the owner's sign-in or
# token, or the desk's agent token (FOLDRENDER_DESK_TOKEN).
cmd_desk_owner() {
  local name="" set="" mode=text n
  while [ $# -gt 0 ]; do
    case "$1" in
      --name) need $# "$1"; name="$2"; set=1; shift 2 ;;
      --clear) name=""; set=1; shift ;;
      --json) mode=json; shift ;;
      *) die 2 "desk owner [--name NAME | --clear] [--json]" ;;
    esac
  done
  ACCEPT="application/json"
  if [ -n "$set" ]; then
    printf '{"name":%s}' "$(json_arg "$name")" > "$TMP/req"
    api POST "/api/desk/owner" -H "$(desk_auth)" -H "Content-Type: application/json" --data-binary "@$TMP/req"
  else
    api GET "/api/desk/owner" -H "$(desk_auth)"
  fi
  ACCEPT="text/plain"
  case "$STATUS" in
    2??) ;;
    401) die 3 "not signed in, or the token was rejected ($(error_text))" ;;
    403) die 3 "this token may not name the desk's owner: use your sign-in, your API token or the desk's agent token ($(error_text))" ;;
    404) die 7 "no desk for this account (foldrender desk init makes one)" ;;
    422) die 1 "refused: the name is one line of at most 32 characters, and nothing that looks like a secret" ;;
    *) fail_http ;;
  esac
  [ "$mode" = json ] && { cat "$TMP/body"; printf '\n'; return 0; }
  n="$(json_get str name 2>/dev/null || true)"
  if [ -n "$n" ]; then printf 'the desk calls you %s\n' "$n"; else printf 'no name: the desk shows your login'"'"'s first letter\n'; fi
}

# foldrender desk mem ...: the desk's memory (src/desk-mem.js on the Worker):
# sessions, events and observations kept in your desk's room — what your
# agents saw, and the decisions only your answers on the desk make. Read with the
# desk's agent token (FOLDRENDER_DESK_TOKEN) or your sign-in, as the cards are.
mem_fail() {
  local msg
  msg="$(error_text)"
  case "$STATUS" in
    401) die 3 "not signed in, or the token was rejected ($msg)" ;;
    403) die 3 "agents write the desk's memory with a token (foldrender desk token add --role agent), not from a page ($msg)" ;;
    404) die 7 "${msg:-not found}: this account has no desk app, or no such memory path (foldrender.dev/desk)" ;;
    413) die 5 "too large: $msg" ;;
    429) die 4 "$msg" ;;
    400|422) die 1 "refused ($msg)$(sed -n 's/.*"field" *: *"\([^"]*\)".*/, field \1/p' "$TMP/body" | head -n 1)" ;;
    *) fail_http ;;
  esac
}

cmd_desk_mem() {
  case "${1:-}" in --help|-h|help) cmd_help desk-mem; return 0 ;; esac
  local sub="${1:-status}" mode=text a q="" limit="" kind="" basis="" repo="" file="" key="" text="" source="" by="" via="" at="" ref="" session="" agent="" machine="" expires=""
  [ $# -eq 0 ] || shift
  [ "$sub" != install ] || { cmd_desk_mem_install "$@"; return; }
  local rest=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) mode=json; shift ;;
      --limit) need $# "$1"; limit="$2"; shift 2 ;;
      --kind) need $# "$1"; kind="$2"; shift 2 ;;
      --basis) need $# "$1"; basis="$2"; shift 2 ;;
      --repo) need $# "$1"; repo="$2"; shift 2 ;;
      --file) need $# "$1"; file="$2"; shift 2 ;;
      --key) need $# "$1"; key="$2"; shift 2 ;;
      --text) need $# "$1"; text="$2"; shift 2 ;;
      --source) need $# "$1"; source="$2"; shift 2 ;;
      --by) need $# "$1"; by="$2"; shift 2 ;;
      --via) need $# "$1"; via="$2"; shift 2 ;;
      --at) need $# "$1"; at="$(desk_when "$2")"; shift 2 ;;
      --ref) need $# "$1"; ref="$2"; shift 2 ;;
      --session) need $# "$1"; session="$2"; shift 2 ;;
      --agent) need $# "$1"; agent="$2"; shift 2 ;;
      --machine) need $# "$1"; machine="$2"; shift 2 ;;
      --expires) need $# "$1"; expires="$(desk_when "$2")"; shift 2 ;;
      --help|-h) cmd_help desk-mem; return 0 ;;
      -) rest+=("$1"); shift ;;
      -*) die 2 "desk mem $sub: unknown option $1 (foldrender help desk-mem)" ;;
      *) rest+=("$1"); shift ;;
    esac
  done
  set -- ${rest[@]+"${rest[@]}"}
  mem_opt() { [ -z "$2" ] || printf ',"%s":%s' "$1" "$(json_arg "$2")"; }
  case "$sub" in
    status)
      api GET "/api/desk/mem/status" -H "$(desk_auth)"
      [ "${STATUS#2}" != "$STATUS" ] || mem_fail
      [ "$mode" = json ] && { cat "$TMP/body"; printf '\n'; return 0; }
      cat "$TMP/body"; printf '\n'
      ;;
    inject)
      q=""; [ -z "$repo" ] || q="?repo=$(urlencode "$repo")"
      api GET "/api/desk/mem/inject$q" -H "$(desk_auth)"
      [ "${STATUS#2}" != "$STATUS" ] || mem_fail
      cat "$TMP/body"
      ;;
    search)
      local qs="?q=$(urlencode "${1:-}")"
      [ -z "$kind" ] || qs="$qs&kind=$(urlencode "$kind")"
      [ -z "$basis" ] || qs="$qs&basis=$(urlencode "$basis")"
      [ -z "$limit" ] || qs="$qs&limit=$(urlencode "$limit")"
      api GET "/api/desk/mem/search$qs" -H "$(desk_auth)"
      [ "${STATUS#2}" != "$STATUS" ] || mem_fail
      [ "$mode" = json ] && { cat "$TMP/body"; printf '\n'; return 0; }
      cat "$TMP/body"; printf '\n'
      ;;
    obs)
      [ -n "${1:-}" ] || die 2 "desk mem obs ID[,ID...]"
      api GET "/api/desk/mem/obs?id=$(urlencode "$1")" -H "$(desk_auth)"
      [ "${STATUS#2}" != "$STATUS" ] || mem_fail
      [ "$mode" = json ] && { cat "$TMP/body"; printf '\n'; return 0; }
      cat "$TMP/body"; printf '\n'
      ;;
    sessions)
      api GET "/api/desk/mem/sessions" -H "$(desk_auth)"
      [ "${STATUS#2}" != "$STATUS" ] || mem_fail
      [ "$mode" = json ] && { cat "$TMP/body"; printf '\n'; return 0; }
      cat "$TMP/body"; printf '\n'
      ;;
    events)
      local qs=""
      [ -z "$session" ] || qs="${qs}&session=$(urlencode "$session")"
      [ -z "$limit" ] || qs="${qs}&limit=$(urlencode "$limit")"
      api GET "/api/desk/mem/events${qs:+?${qs#&}}" -H "$(desk_auth)"
      [ "${STATUS#2}" != "$STATUS" ] || mem_fail
      [ "$mode" = json ] && { cat "$TMP/body"; printf '\n'; return 0; }
      cat "$TMP/body"; printf '\n'
      ;;
    say)
      # One event a hook would send: {kind, text, agent?, machine?, repo?,
      # session?, by?, via?, at?, ref?}. kind is prompt|stop|summary|mark|tool.
      kind="${kind:-mark}"
      case "$kind" in prompt|stop|summary|mark|tool) ;; *) die 2 "desk mem say --kind prompt|stop|summary|mark|tool" ;; esac
      [ -n "$text" ] || text="${1:-}"
      if [ "$file" = - ] || [ "$text" = - ]; then text="$(cat)"
      elif [ -n "$file" ]; then [ -f "$file" ] || die 2 "no file $file"; text="$(cat "$file")"
      fi
      [ -n "$text" ] || die 2 "desk mem say TEXT|--text T|--file F|- [--kind K] [--agent A] [--machine M] [--repo R] [--session ID] [--by N] [--via V] [--at WHEN] [--ref R]"
      printf '{"kind":%s,"text":%s%s%s%s%s%s%s%s%s}' "$(json_arg "$kind")" "$(json_arg "$text")" "$(mem_opt agent "$agent")" "$(mem_opt machine "$machine")" "$(mem_opt repo "$repo")" "$(mem_opt session "$session")" "$(mem_opt by "$by")" "$(mem_opt via "$via")" "$(mem_opt at "$at")" "$(mem_opt ref "$ref")" > "$TMP/req"
      api POST "/api/desk/mem/events" -H "$(desk_auth)" -H "Content-Type: application/json" --data-binary "@$TMP/req"
      [ "${STATUS#2}" != "$STATUS" ] || mem_fail
      [ "$mode" = json ] && { cat "$TMP/body"; printf '\n'; return 0; }
      printf 'added: %s event(s)\n' "$(sed -n 's/.*"added":\([0-9]*\).*/\1/p' "$TMP/body")"
      ;;
    flush)
      # A hook's batch of events: lines of JSON or {events:[...]} on a file/-.
      [ -n "$file" ] || file="${1:--}"
      if [ "$file" = - ]; then cat > "$TMP/flush"; file="$TMP/flush"; fi
      [ -f "$file" ] || die 2 "no file $file"
      api POST "/api/desk/mem/events" -H "$(desk_auth)" -H "Content-Type: application/json" --data-binary "@$file"
      [ "${STATUS#2}" != "$STATUS" ] || mem_fail
      [ "$mode" = json ] && { cat "$TMP/body"; printf '\n'; return 0; }
      printf 'added: %s, unchanged: %s\n' "$(sed -n 's/.*"added":\([0-9]*\).*/\1/p' "$TMP/body")" "$(sed -n 's/.*"unchanged":\([0-9]*\).*/\1/p' "$TMP/body")"
      ;;
    note)
      # One observation: {kind, basis, source, quote, text}: a discovery, a
      # change, a note or an ask. Never a decision (the API refuses one):
      # those come only from the owner's answers on the desk.
      kind="${kind:-note}"; basis="${basis:-inferred}"
      [ -n "${text:-}" ] || die 2 "desk mem note TEXT --kind K --basis B --source S [--quote-file F] [--at WHEN] [--expires WHEN]"
      local quote=""
      [ -z "$file" ] || quote="$(cat "$file")"
      printf '{"kind":%s,"basis":%s,"source":%s,"quote":%s,"text":%s%s%s}' "$(json_arg "$kind")" "$(json_arg "$basis")" "$(json_arg "${source:-cli}")" "$(json_arg "$quote")" "$(json_arg "$text")" "$(mem_opt at "$at")" "${expires:+,\"expires_at\":$(json_arg "$expires")}" > "$TMP/req"
      api POST "/api/desk/mem/obs" -H "$(desk_auth)" -H "Content-Type: application/json" --data-binary "@$TMP/req"
      [ "${STATUS#2}" != "$STATUS" ] || mem_fail
      [ "$mode" = json ] && { cat "$TMP/body"; printf '\n'; return 0; }
      printf 'obs %s\n' "$(sed -n 's/.*"id":\([0-9]*\).*/\1/p' "$TMP/body" | head -n 1)"
      ;;
    import)
      # Observations from a file, one JSON object a line (as `desk mem note`
      # sends one), 100 to a request at most. With basis "imported" and a source of
      # its own, each is kept once: the file sent again (after a stop, a
      # quota or a failure) adds only what is not there yet, and what is
      # already there costs none of the day's writes. One the owner forgot
      # (desk mem forget) stays forgotten.
      [ -n "$file" ] || file="${1:--}"
      if [ "$file" = - ]; then cat > "$TMP/import"; file="$TMP/import"; fi
      [ -f "$file" ] || die 2 "no file $file"
      grep -v '^[[:space:]]*$' "$file" > "$TMP/import.lines" || true
      # Each item's line in the file, blank lines counted, for where it stopped.
      grep -n -v '^[[:space:]]*$' "$file" | cut -d: -f1 > "$TMP/import.nums" || true
      local total sent=0 added=0 unchanged=0 forgotten=0 part n again at
      total=$(wc -l < "$TMP/import.lines" | tr -d ' ')
      [ "$total" -gt 0 ] || die 2 "desk mem import: $file has no lines (one JSON object a line)"
      # At most 100 to a request and under the API's 64 KB a request (bytes,
      # so C); a line that is more on its own goes alone and is refused.
      LC_ALL=C awk -v pre="$TMP/import.part." -v max=60000 '
        { b = length($0) + 1
          if (n == 100 || (n > 0 && size + b > max)) { close(f); k++; n = 0; size = 0 }
          f = sprintf("%s%06d", pre, k); print > f; n++; size += b }' "$TMP/import.lines"
      for part in "$TMP"/import.part.*; do
        { printf '{"obs":['; paste -sd, "$part"; printf ']}'; } > "$TMP/req"
        n=$(wc -l < "$part" | tr -d ' ')
        api POST "/api/desk/mem/obs" -H "$(desk_auth)" -H "Content-Type: application/json" --data-binary "@$TMP/req"
        if [ "${STATUS#2}" = "$STATUS" ]; then
          [ "$mode" = json ] || [ "$total" -le 100 ] || printf '\n' >&2
          # A day's quota: the same command after 00:00 UTC goes on (what is
          # kept costs nothing then); sent again today it is refused again.
          again="Run it again to go on."
          [ "$STATUS" != 429 ] || ! grep -q -E '"code" *: *"quota"|^code: *quota' "$TMP/body" || again="Run it again after 00:00 UTC to go on; until then it is refused again."
          at=$((sent + $(sed -n -e 's/^index: *\([0-9][0-9]*\).*/\1/p' -e 's/.*"index":\([0-9][0-9]*\).*/\1/p' "$TMP/body" | head -n 1 | grep . || echo 0) + 1))
          printf 'desk mem import: stopped at line %s of %s; added %s, unchanged %s before it. %s\n' \
            "$(sed -n "${at}p" "$TMP/import.nums")" "$(awk 'END { print NR }' "$file")" "$added" "$unchanged" "$again" >&2
          mem_fail
        fi
        added=$((added + $(grep -o '"result":"added"' "$TMP/body" | wc -l)))
        unchanged=$((unchanged + $(grep -o '"result":"unchanged"' "$TMP/body" | wc -l)))
        forgotten=$((forgotten + $(grep -o '"result":"forgotten"' "$TMP/body" | wc -l)))
        sent=$((sent + n))
        [ "$mode" = json ] || [ "$total" -le 100 ] || printf '\r%s of %s' "$sent" "$total" >&2
      done
      [ "$mode" = json ] || [ "$total" -le 100 ] || printf '\n' >&2
      [ "$mode" = json ] && { printf '{"lines":%s,"added":%s,"unchanged":%s,"forgotten":%s}\n' "$total" "$added" "$unchanged" "$forgotten"; return 0; }
      printf 'added: %s, unchanged: %s%s (of %s)\n' "$added" "$unchanged" "$([ "$forgotten" = 0 ] || printf ', forgotten: %s' "$forgotten")" "$total"
      ;;
    forget)
      # Hide what came from one source (a card's answer, a message).
      [ -n "${source:-}" ] || die 2 "desk mem forget --source SOURCE (e.g. card:KEY:bN, thread:KEY)"
      printf '{"source":%s}' "$(json_arg "$source")" > "$TMP/req"
      api POST "/api/desk/mem/obs/hide" -H "$(desk_auth)" -H "Content-Type: application/json" --data-binary "@$TMP/req"
      [ "${STATUS#2}" != "$STATUS" ] || mem_fail
      printf 'hidden: %s\n' "$source"
      ;;
    *) die 2 "unknown desk mem command: $sub (foldrender help desk-mem)" ;;
  esac
}

# foldrender desk mem install [--agent claude|codex|all] [--remove]: writes
#   the hooks that feed the memory and hand a new session what it holds.
#   Claude Code and Codex get hook entries (Codex asks you to trust them once
#   in its /hooks); the others (agy, grok, pi, opencode) have no hook here yet
#   and use desk mem say / inject by hand. The desk agent token (frdk_) is
#   kept in a 600 file the hook reads, and what was said goes to the hook on
#   stdin and on to the Worker in a file: neither is ever on a command line.
cmd_desk_mem_install() {
  local agents="" conf token="" remove=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --agent) need $# "$1"; agents="$agents,$2"; shift 2 ;;
      --remove) remove=1; shift ;;
      -*) die 2 "desk mem install: unknown option $1 (foldrender help desk-mem)" ;;
      *) agents="$agents,$1"; shift ;;
    esac
  done
  agents="${agents#,}"; agents="${agents:-claude,codex}"
  case ",$agents," in *,all,*) agents="claude,codex" ;; esac
  local a list=""
  for a in $(printf '%s' "$agents" | tr ',' ' '); do
    case "$a" in
      claude|codex) list="$list $a" ;;
      agy|gemini|grok|pi|opencode) note "$a: no hook yet; its sessions can still feed the memory with  foldrender desk mem say  and read it with  foldrender desk mem inject" ;;
      *) die 2 "desk mem install --agent claude|codex|all (not $a)" ;;
    esac
  done
  command -v python3 >/dev/null 2>&1 || die 1 "desk mem install needs python3 (it edits the agents' hook files)"
  conf="${FOLDRENDER_DESK_MEM_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/foldrender/desk-mem}"
  if [ "$remove" = 1 ]; then
    [ -f "$conf/install.py" ] || die 7 "nothing installed under $conf"
    [ -z "$list" ] || FR_MEM_CONF="$conf" python3 "$conf/install.py" --remove $list
    return 0
  fi
  [ -n "$list" ] || return 0
  # The desk's agent token (frdk_, role agent: what the memory's API takes),
  # made with your sign-in and kept in a 600 file. It is never printed: the
  # hook reads it from the file into FOLDRENDER_DESK_TOKEN when it runs.
  ( umask 077 && mkdir -p "$conf" ) || die 1 "cannot make $conf"
  if ! { [ -f "$conf/token" ] && head -n 1 "$conf/token" | grep -Eq '^frdk_[A-Za-z0-9_-]{20,200}$'; }; then
    case "${FOLDRENDER_DESK_TOKEN:-}" in
      frdk_*) token="$FOLDRENDER_DESK_TOKEN" ;;
      *)
        require_token
        DESK_ID="${FOLDRENDER_DESK:-desk}"; check_slug "$DESK_ID" 2>/dev/null || DESK_ID=desk
        printf '{"role":"agent","name":"mem-hook-%s"}' "$(default_machine_name | tr -cd 'A-Za-z0-9_.-' | cut -c1-40)" > "$TMP/req"
        desk_send POST /tokens -H "$(auth_header)" -H "Content-Type: application/json" --data-binary "@$TMP/req"
        [ "${STATUS#2}" != "$STATUS" ] || mem_fail
        token="$(json_get str token 2>/dev/null)" ;;
    esac
    case "$token" in frdk_*) ;; *) die 1 "no desk agent token: run  foldrender desk token add --role agent --name mem-hook  and put the frdk_... it prints into $conf/token (chmod 600)" ;; esac
    ( umask 077 && printf '%s\n' "$token" > "$conf/token" ) || die 1 "cannot write $conf/token"
    token=""
  fi
  # The hook: $1 is what happened (start|prompt|stop), $2 the agent; the
  # agent's hook JSON comes on stdin.
  cat > "$TMP/hook" <<'H'
#!/bin/sh
# foldrender desk mem hook, written by 'foldrender desk mem install'.
# $1 is what happened (start, prompt, stop), $2 the agent; the agent's hook
# JSON comes on stdin. The desk's agent token is read from the 600 file next
# to this one, and what was said goes on in a 600 file: neither is ever on a
# command line. It always exits 0 so the agent is never held up by it.
umask 077
conf="$(cd "$(dirname "$0")" && pwd)"
FOLDRENDER_DESK_TOKEN="$(head -n 1 "$conf/token" 2>/dev/null)"; export FOLDRENDER_DESK_TOKEN
# The command and the API it was installed with (an API only when one was named).
cli="${FOLDRENDER_CLI:-$(head -n 1 "$conf/cli" 2>/dev/null)}"; cli="${cli:-foldrender}"
if [ -z "${FOLDRENDER_API:-}" ] && [ -s "$conf/api" ]; then FOLDRENDER_API="$(head -n 1 "$conf/api")"; export FOLDRENDER_API; fi
log="$conf/hook.log"
t="$(umask 077 && mktemp "${TMPDIR:-/tmp}/fr-mem.XXXXXX")" || exit 0
cat > "$t"
case "$1" in
  start)
    # What a new session is handed, on stdout (the agent adds it to the context).
    repo="$(python3 -I "$conf/event.py" repo "${2:-other}" < "$t" 2>>"$log")"
    rm -f "$t"
    "$cli" desk mem inject ${repo:+--repo "$repo"} 2>>"$log" || true ;;
  prompt|stop)
    if python3 -I "$conf/event.py" "$1" "${2:-other}" < "$t" > "$t.json" 2>>"$log"; then
      # Sent in the background: a slow network never holds the agent up.
      ( "$cli" desk mem flush "$t.json" >/dev/null 2>>"$log"; rm -f "$t" "$t.json" ) </dev/null >/dev/null 2>&1 &
    else rm -f "$t" "$t.json"; fi ;;
  *) rm -f "$t" ;;
esac
exit 0
H
  cat > "$TMP/event" <<'PY'
# foldrender desk mem: the agent's hook JSON (stdin) to the event the desk keeps.
import hashlib, json, os, socket, subprocess, sys
what, agent = sys.argv[1], (sys.argv[2] if len(sys.argv) > 2 else "other")
try:
    d = json.load(sys.stdin)
except Exception:
    d = {}
if not isinstance(d, dict):
    d = {}
cwd = str(d.get("cwd") or os.getcwd())
# The repository's name: the folder that holds its .git, which a worktree
# shares with its main checkout; else the folder the session runs in.
repo = os.path.basename(cwd.rstrip("/"))
try:
    g = subprocess.run(["git", "-C", cwd, "rev-parse", "--path-format=absolute", "--git-common-dir"], capture_output=True, text=True, timeout=3)
    common = g.stdout.strip()
    if g.returncode == 0 and common:
        top = os.path.dirname(common.rstrip("/")) if os.path.basename(common.rstrip("/")) == ".git" else common
        repo = os.path.basename(top.rstrip("/")) or repo
except Exception:
    pass
repo = repo[:128]
if what == "repo":
    print(repo)
    sys.exit(0)
def last_reply():
    t = d.get("last_assistant_message")
    if isinstance(t, str) and t.strip():
        return t
    p = d.get("transcript_path")
    if not isinstance(p, str) or not os.path.isfile(p):
        return ""
    with open(p, "rb") as f:
        f.seek(0, 2)
        f.seek(max(0, f.tell() - 4 * 1024 * 1024))
        lines = f.read().decode("utf-8", "replace").splitlines()
    for line in reversed(lines):
        try:
            o = json.loads(line)
        except Exception:
            continue
        m = o.get("message") if isinstance(o, dict) else None
        if o.get("type") != "assistant" or not isinstance(m, dict):
            continue
        c = m.get("content")
        if isinstance(c, str) and c.strip():
            return c
        if isinstance(c, list):
            s = "\n".join(b.get("text", "") for b in c if isinstance(b, dict) and b.get("type") == "text").strip()
            if s:
                return s
    return ""
text = (d.get("prompt") or "") if what == "prompt" else last_reply()
text = str(text).strip()[:4000]
if not text:
    sys.exit(1)
sid = str(d.get("session_id") or "")
# 24 hex digits (96 bits): a longer run would be taken for a secret and refused.
ref = what[0] + "-" + hashlib.sha256((sid + "\0" + what + "\0" + text).encode("utf-8")).hexdigest()[:24]
print(json.dumps({"events": [{"kind": what, "text": text, "agent": agent, "machine": socket.gethostname().split(".")[0][:64], "repo": repo, "ref": ref}]}, ensure_ascii=False))
PY
  # A writer for the agents' hook files: it adds or removes our entries and
  # leaves everything else in them as it was.
  cat > "$TMP/install" <<'PY'
import json, os, sys
HOME = os.path.expanduser("~")
CONF = os.environ["FR_MEM_CONF"]
HOOK = os.path.join(CONF, "desk-mem-hook.sh")
FILES = {"claude": os.path.join(HOME, ".claude", "settings.json"), "codex": os.path.join(os.environ.get("CODEX_HOME") or os.path.join(HOME, ".codex"), "hooks.json")}
EVENTS = {"SessionStart": "start", "UserPromptSubmit": "prompt", "Stop": "stop"}
args = sys.argv[1:]
remove = "--remove" in args
def ours(h):
    return isinstance(h, dict) and HOOK in str(h.get("command", ""))
for agent in [a for a in args if a in FILES]:
    path = FILES[agent]
    try:
        with open(path) as f:
            d = json.load(f)
    except FileNotFoundError:
        d = {}
    except Exception as e:
        print(f"{agent}: {path} is not JSON ({e}); left as it is", file=sys.stderr)
        continue
    hooks = d.setdefault("hooks", {})
    for event, what in EVENTS.items():
        groups = hooks.get(event) if isinstance(hooks.get(event), list) else []
        for g in groups:
            if isinstance(g, dict) and isinstance(g.get("hooks"), list):
                g["hooks"] = [h for h in g["hooks"] if not ours(h)]
        groups = [g for g in groups if not (isinstance(g, dict) and isinstance(g.get("hooks"), list) and not g["hooks"])]
        if not remove:
            groups.append({"hooks": [{"type": "command", "command": f'"{HOOK}" {what} {agent}', "timeout": 15}]})
        if groups:
            hooks[event] = groups
        else:
            hooks.pop(event, None)
    if not hooks:
        d.pop("hooks", None)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".fr-mem.tmp"
    with open(tmp, "w") as f:
        json.dump(d, f, indent=2, ensure_ascii=False)
        f.write("\n")
    if os.path.exists(path):
        os.chmod(tmp, os.stat(path).st_mode & 0o777)
    os.replace(tmp, path)
    print(f"{agent}: {'removed from' if remove else 'hooks in'} {path}")
PY
  ( umask 077 && cp "$TMP/hook" "$conf/desk-mem-hook.sh" && chmod 700 "$conf/desk-mem-hook.sh" && cp "$TMP/event" "$conf/event.py" && cp "$TMP/install" "$conf/install.py" \
    && cli_path > "$conf/cli" && if [ -n "${FOLDRENDER_API:-}" ]; then printf '%s\n' "$API" > "$conf/api"; else rm -f "$conf/api"; fi ) || die 1 "cannot write the hook under $conf"
  FR_MEM_CONF="$conf" python3 "$conf/install.py" $list || die 1 "the agents' hook files could not be written"
  case " $list " in *" codex "*) note "codex: open codex, run /hooks and trust the three foldrender desk mem hooks once; until then Codex does not run them" ;; esac
  note "desk memory hooks are under $conf (token in $conf/token, 600). A new session is handed what  foldrender desk mem inject --repo REPO  prints; take them out with  foldrender desk mem install --remove"
}

cmd_desk_machine() {
  local op="${1:-ls}" name="" replace="" mode=text
  [ $# -eq 0 ] || shift
  case "$op" in
    add)
      while [ $# -gt 0 ]; do
        case "$1" in
          --replace) replace=1; shift ;;
          --json) mode=json; shift ;;
          -*) die 2 "desk machine add: unknown option $1" ;;
          *) [ -z "$name" ] || die 2 "desk machine add takes one NAME"; name="$1"; shift ;;
        esac
      done
      [ -n "$name" ] || die 2 "which machine? foldrender desk machine add NAME"
      check_machine_name "$name"
      machine_add "$name" "$replace"
      [ "$mode" = json ] && { cat "$TMP/body"; printf '\n'; return 0; }
      json_get str token
      printf '\n'
      note "machine $name (id $(json_get str id 2>/dev/null || printf '?')): its token is shown once. Keep it in a 600 file or a secret store, never in a command line; on that machine: foldrender desk agent install --token-file FILE (or foldrender desk agent install there, signed in, which makes and keeps its own)"
      ;;
    ls)
      while [ $# -gt 0 ]; do case "$1" in --json) mode=json; shift ;; *) die 2 "desk machine ls [--json]" ;; esac; done
      ACCEPT="application/json"
      api_auth GET "/api/desk/machines"
      ACCEPT="text/plain"
      expect_2xx
      [ "$mode" = json ] && { cat "$TMP/body"; printf '\n'; return 0; }
      node_json_lines "$TMP/body" || cat "$TMP/body"
      ;;
    rm)
      [ $# -eq 1 ] || die 2 "desk machine rm ID (desk machine ls)"
      case "$1" in ''|*[!0-9a-f]*) die 2 "a machine's id is 16 hex characters (desk machine ls)" ;; esac
      [ "${#1}" -eq 16 ] || die 2 "a machine's id is 16 hex characters (desk machine ls)"
      api_auth DELETE "/api/desk/machines/$1"
      case "$STATUS" in
        2??) printf 'revoked machine %s: its agent is disconnected, and what it reported is gone from the desk\n' "$1" ;;
        404) die 7 "no machine $1 on this desk that is not revoked already (desk machine ls)" ;;
        *) fail_http ;;
      esac
      ;;
    *) die 2 "desk machine add NAME | ls | rm ID (foldrender help desk)" ;;
  esac
}

# The machines' list, a line each: ID  NAME  made …  last heard …  [revoked]
# (node reads the JSON; without node, the JSON is printed as it came).
node_json_lines() {
  command -v node >/dev/null 2>&1 || return 1
  node -e '
    const b = JSON.parse(require("fs").readFileSync(process.argv[1], "utf8"));
    const ms = Array.isArray(b.machines) ? b.machines : [];
    if (!ms.length) console.log("no machines yet: foldrender desk agent install (on the machine), or foldrender desk machine add NAME");
    for (const m of ms) console.log([m.id, m.name, "made " + (m.created_at || "?"), "last heard " + (m.last_used_at || "never"), m.revoked_at ? "revoked " + m.revoked_at : ""].filter(Boolean).join("  "));
  ' "$1"
}

# The foldrender command itself, by its absolute path (what a service runs).
cli_path() {
  local p="$0" d
  case "$p" in */*) ;; *) p="$(command -v -- "$p" 2>/dev/null)" || p="$0" ;; esac
  d="$(cd "$(dirname "$p")" 2>/dev/null && pwd -P)" || die 1 "cannot tell where this foldrender command is"
  printf '%s/%s' "$d" "$(basename "$p")"
}

# foldrender desk agent run|install|status|uninstall: the program that tells
# the desk what runs on this computer (herdr's agents and the machine's load),
# kept running by install. It is a Node program (foldrender-desk-agent.mjs)
# fetched from the site once, checked against FR_DESK_AGENT_SHA256 and kept in
# the cache folder, as the bridge is. Its token is the machine's (frdm_), in a
# 600 file; install makes one with your sign-in when there is none.
cmd_desk_agent() {
  local op="${1:-}" node_major file cache url got cli want_token="" name="" replace="" a
  [ $# -eq 0 ] || shift
  case "$op" in
    run|install|status|uninstall) ;;
    '') die 2 "desk agent run | install | status | uninstall (foldrender help desk)" ;;
    *) die 2 "unknown desk agent command: $op (run, install, status, uninstall)" ;;
  esac
  command -v node >/dev/null 2>&1 || die 2 "the desk agent needs Node 22 or later (https://nodejs.org); it is not installed"
  node_major="$(node -p 'process.versions.node.split(".")[0]' 2>/dev/null)"
  case "$node_major" in ''|*[!0-9]*) node_major=0 ;; esac
  [ "$node_major" -ge 22 ] || die 2 "the desk agent needs Node 22 or later; this is $(node -v 2>/dev/null)"
  if [ -n "${FOLDRENDER_DESK_AGENT:-}" ]; then
    file="$FOLDRENDER_DESK_AGENT"
    [ -f "$file" ] || die 2 "FOLDRENDER_DESK_AGENT=$file is not a file"
  else
    cache="${XDG_CACHE_HOME:-$HOME/.cache}/foldrender"
    file="$cache/desk-agent-$FR_DESK_AGENT_SHA256.mjs"
    if [ ! -f "$file" ] || [ "$(sha256_of "$file")" != "$FR_DESK_AGENT_SHA256" ]; then
      mkdir -p "$cache" || die 1 "cannot make $cache"
      url="${API%/artifacts}/install/desk-agent/$FR_DESK_AGENT_SHA256.mjs"
      curl -fsS --connect-timeout 15 --max-time 120 -o "$TMP/desk-agent.mjs" "$url" 2>"$TMP/err" || die 6 "cannot fetch the desk agent from $url ($(curl_error))"
      got="$(sha256_of "$TMP/desk-agent.mjs")"
      [ "$got" = "$FR_DESK_AGENT_SHA256" ] || die 1 "the desk agent at $url is not the one this foldrender ($FR_CLI_VERSION) runs; update foldrender: curl -fsSL ${API%/artifacts}/install.sh | sh"
      mv "$TMP/desk-agent.mjs" "$file" || die 1 "cannot write $file"
    fi
  fi
  cli="$(cli_path)"
  if [ -n "${FOLDRENDER_API:-}" ]; then set -- --cli "$cli" --api "$API" "$@"; else set -- --cli "$cli" "$@"; fi
  case "$op" in
    run)
      # The service's own process from here (signals reach it), and nothing
      # of this run left behind: cron starts this every minute.
      rm -rf "$TMP"
      exec node "$file" run "$@"
      ;;
    install)
      for a in "$@"; do
        case "$a" in
          --token-file) want_token=given ;;
          --replace) replace=1 ;;
        esac
      done
      # --replace and --name are this command's; the program takes --name.
      local args=() prev=""
      for a in "$@"; do
        if [ "$prev" = --name ]; then name="$a"; fi
        prev="$a"
        [ "$a" = --replace ] || args+=("$a")
      done
      if [ -z "$want_token" ] && { [ -n "$replace" ] || ! desk_agent_token_ok; }; then
        # No token here yet (or --replace): one made now with your sign-in,
        # handed to the program on its standard input, never printed.
        require_token
        [ -n "$name" ] || { name="$(default_machine_name)"; args+=(--name "$name"); }
        check_machine_name "$name"
        machine_add "$name" "$replace"
        json_get str token > "$TMP/machine-token" || die 1 "the desk sent no token"
        node "$file" install "${args[@]}" --token-file - < "$TMP/machine-token"
        a=$?
        rm -f "$TMP/machine-token"
        return "$a"
      fi
      node "$file" install "${args[@]}"
      ;;
    *) node "$file" "$op" "$@" ;;
  esac
}

# Whether this computer has a machine token for the desk agent already.
desk_agent_token_ok() {
  local f="${FOLDRENDER_DESK_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/foldrender/desk-agent}/token"
  [ -f "$f" ] && head -n 1 "$f" | grep -Eq '^frdm_[A-Za-z0-9_-]{20,200}$'
}

# foldrender bridge --page PAGE [--agent NAME] [--dir DIR]: connects a coding
# agent on this computer to the page's agent sidebar, until stopped. The bridge
# is a Node program (foldrender-bridge.mjs) fetched from the site once, checked
# against FR_BRIDGE_SHA256 and kept in the cache folder; the sign-in goes to it
# in the environment, never on its command line.
# foldrender thread ...: the owner's messages on their desk (the second
# version's room), each the root of a tree on the page: what they said, then
# the assistant's replies, the sessions sent to work on it and what those
# reported. Written with the desk's agent token (FOLDRENDER_DESK_TOKEN) or the
# signed-in account, as the desk's cards are.
thread_fail() {
  local msg
  msg="$(error_text)"
  case "$STATUS" in
    401) die 3 "not signed in, or the token was rejected ($msg)" ;;
    404) die 7 "${msg:-not found}: no such thread, or this account has no desk app (foldrender.dev/desk)" ;;
    413) die 5 "too large: $msg" ;;
    422|400) die 1 "refused ($msg)$(sed -n 's/.*"field" *: *"\([^"]*\)".*/, field \1/p' "$TMP/body" | head -n 1)" ;;
    429) die 4 "$msg" ;;
    *) fail_http ;;
  esac
}
thread_key() {
  case "$1" in
    t-*) case "$1" in *[!A-Za-z0-9_.:-]*) die 2 "a thread's key is t- and letters, digits, . _ : - : $1" ;; esac ;;
    *) die 2 "a thread's key starts with t- (foldrender thread ls lists them): $1" ;;
  esac
}
# The text: an argument, or a file (- for stdin) with --text-file.
thread_text() {
  if [ -n "$2" ]; then
    if [ "$2" = - ]; then cat > "$TMP/ttext"; else [ -f "$2" ] || die 2 "no such file: $2"; cat "$2" > "$TMP/ttext"; fi
    json_file "$TMP/ttext"
  else
    [ -n "$1" ] || die 2 "say what was said: a text argument, or --text-file FILE (- for stdin)"
    json_arg "$1"
  fi
}
thread_post() {
  local path="$1" mode="$2"
  ACCEPT="application/json"
  api POST "/api/desk/threads$path" -H "$(desk_auth)" -H "Content-Type: application/json" --data-binary "@$TMP/req"
  [ "${STATUS#2}" != "$STATUS" ] || thread_fail
  [ "$mode" != json ] || { cat "$TMP/body"; printf '\n'; return 1; }
  return 0
}
thread_hidden() {
  local n
  n="$(sed -n 's/.*"hidden" *: *\([0-9]*\).*/\1/p' "$TMP/body" | head -n 1)"
  [ "${n:-0}" = 0 ] || note "$n piece(s) that looked like a secret were kept as [hidden]"
}
cmd_thread() {
  case "${1:-}" in --help|-h|help) cmd_help thread; return 0 ;; esac
  local sub="${1:-ls}" mode=text a key="" text="" tfile="" kind="" by="" via="" at="" ref="" rref="" into="" seq="" parent="" channel="" machine="" agent="" closed="" limit="" body
  local adds=()
  [ $# -eq 0 ] || shift
  local rest=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) mode=json; shift ;;
      --key) need $# "$1"; key="$2"; shift 2 ;;
      --text-file) need $# "$1"; tfile="$2"; shift 2 ;;
      --kind) need $# "$1"; kind="$2"; shift 2 ;;
      --by) need $# "$1"; by="$2"; shift 2 ;;
      --via) need $# "$1"; via="$2"; shift 2 ;;
      --at) need $# "$1"; at="$(desk_when "$2")"; shift 2 ;;
      --ref) need $# "$1"; ref="$2"; shift 2 ;;
      --reply-to-ref) need $# "$1"; rref="$2"; shift 2 ;;
      --add) need $# "$1"; adds+=("$2"); shift 2 ;;
      --into) need $# "$1"; into="$2"; shift 2 ;;
      --seq) need $# "$1"; seq="$2"; shift 2 ;;
      --parent) need $# "$1"; parent="$2"; shift 2 ;;
      --channel) need $# "$1"; channel="$2"; shift 2 ;;
      --machine) need $# "$1"; machine="$2"; shift 2 ;;
      --agent) need $# "$1"; agent="$2"; shift 2 ;;
      --closed) closed=true; shift ;;
      --open) closed=false; shift ;;
      --limit) need $# "$1"; limit="$2"; shift 2 ;;
      --help|-h) cmd_help thread; return 0 ;;
      -) rest+=("$1"); shift ;;
      -*) die 2 "thread $sub: unknown option $1 (foldrender help thread)" ;;
      *) rest+=("$1"); shift ;;
    esac
  done
  set -- ${rest[@]+"${rest[@]}"}
  # Optional fields, as ,"name":value for each one given.
  thread_opt() { [ -z "$2" ] || printf ',"%s":%s' "$1" "$(json_arg "$2")"; }
  case "$sub" in
    new)
      [ -z "$key" ] || thread_key "$key"
      [ -z "$parent" ] || thread_key "$parent"
      body="$(thread_text "${1:-}" "$tfile")"
      printf '{"text":%s%s%s%s%s%s%s%s}' "$body" "$(thread_opt key "$key")" "$(thread_opt at "$at")" "$(thread_opt by "$by")" "$(thread_opt parent "$parent")" "$(thread_opt channel "$channel")" "$(thread_opt ref "$ref")" "$(thread_opt parent_ref "$rref")" > "$TMP/req"
      thread_post "" "$mode" || return 0
      printf '%s\n' "$(sed -n 's/.*"key" *: *"\([^"]*\)".*/\1/p' "$TMP/body")"
      grep -q '"result":"unchanged"' "$TMP/body" && note "this thread was there already (same key or ref): nothing written"
      thread_hidden
      ;;
    reply)
      body="$(thread_text "${2:-${1:-}}" "$tfile")"
      case "$kind" in ''|reply|progress|result|ask) ;; *) die 2 "--kind is reply, progress, result or ask" ;; esac
      if [ -n "$rref" ]; then
        printf '{"reply_to_ref":%s,"text":%s%s%s%s%s%s}' "$(json_arg "$rref")" "$body" "$(thread_opt kind "$kind")" "$(thread_opt by "$by")" "$(thread_opt via "$via")" "$(thread_opt at "$at")" "$(thread_opt ref "$ref")" > "$TMP/req"
        thread_post "/reply" "$mode" || return 0
        key="$(sed -n 's/.*"key" *: *"\([^"]*\)".*/\1/p' "$TMP/body")"
        if grep -q '"result":"unchanged"' "$TMP/body"; then printf 'unchanged: %s already has this reply (--ref)\n' "$key"
        else printf 'added reply %s to %s\n' "$(sed -n 's/.*"seq" *: *\([0-9]*\).*/\1/p' "$TMP/body")" "$key"; fi
        thread_hidden
        return 0
      fi
      [ $# -ge 1 ] || die 2 "thread reply KEY TEXT [--kind reply|progress|result|ask] [--via SESSION] [--by NAME] [--at WHEN] [--ref REF] (or: thread reply --reply-to-ref REF TEXT)"
      thread_key "$1"; key="$1"; shift
      body="$(thread_text "${1:-}" "$tfile")"
      printf '{"text":%s%s%s%s%s%s}' "$body" "$(thread_opt kind "$kind")" "$(thread_opt by "$by")" "$(thread_opt via "$via")" "$(thread_opt at "$at")" "$(thread_opt ref "$ref")" > "$TMP/req"
      thread_post "/$key/reply" "$mode" || return 0
      a="$(sed -n 's/.*"key" *: *"\([^"]*\)".*/\1/p' "$TMP/body")"
      if grep -q '"result":"unchanged"' "$TMP/body"; then printf 'unchanged: %s already has this reply (--ref)\n' "${a:-$key}"
      else printf 'added reply %s to %s\n' "$(sed -n 's/.*"seq" *: *\([0-9]*\).*/\1/p' "$TMP/body")" "${a:-$key}"; fi
      thread_hidden
      ;;
    link)
      [ $# -ge 2 ] || die 2 "thread link KEY SESSION [--machine M] [--agent A] [--parent SESSION] [--closed|--open]"
      thread_key "$1"
      printf '{"session":%s%s%s%s%s%s}' "$(json_arg "$2")" "$(thread_opt machine "$machine")" "$(thread_opt agent "$agent")" "$(thread_opt parent "$parent")" "$(thread_opt at "$at")" "${closed:+,\"closed\":$closed}" > "$TMP/req"
      thread_post "/$1/link" "$mode" || return 0
      a="$(sed -n 's/.*"parent" *: *"\([^"]*\)".*/\1/p' "$TMP/body")"
      printf '%s %s under %s%s\n' "$(sed -n 's/.*"result" *: *"\([^"]*\)".*/\1/p' "$TMP/body")" "$2" "$1" "${a:+, for $a}"
      ;;
    status)
      [ $# -ge 2 ] || die 2 "thread status KEY received|doing|you|done"
      thread_key "$1"
      case "$2" in received|doing|you|done) ;; *) die 2 "a thread's state is received, doing, you or done" ;; esac
      printf '{"state":"%s"}' "$2" > "$TMP/req"
      thread_post "/$1/status" "$mode" || return 0
      printf '%s is %s\n' "$1" "$2"
      ;;
    ls)
      case "${limit:-50}" in *[!0-9]*) die 2 "--limit is a number" ;; esac
      ACCEPT="text/plain"
      [ "$mode" != json ] || ACCEPT="application/json"
      api GET "/api/desk/threads?limit=${limit:-50}" -H "$(desk_auth)"
      [ "${STATUS#2}" != "$STATUS" ] || thread_fail
      cat "$TMP/body"
      [ "$mode" != json ] || printf '\n'
      ;;
    import)
      [ $# -ge 1 ] || die 2 "thread import FILE|- : lines of JSON (the assistant's threads.jsonl, or its record of the sessions it started)"
      if [ "$1" = - ]; then cat > "$TMP/import"; else [ -f "$1" ] || die 2 "no such file: $1"; cat "$1" > "$TMP/import"; fi
      # 100 lines a request (the desk takes 500 at most, and 2 MB).
      rm -f "$TMP"/imp.*
      split -l 100 "$TMP/import" "$TMP/imp."
      local f tries total_t=0 total_r=0 total_l=0 total_s=0 total_u=0 total_k=0 total_h=0 total_n=0 n wait
      for f in "$TMP"/imp.*; do
        [ -s "$f" ] || continue
        tries=0
        while :; do
          ACCEPT="application/json"
          api POST "/api/desk/threads/import" -H "$(desk_auth)" -H "Content-Type: application/x-ndjson" --data-binary "@$f"
          # Too many a minute: as long as the desk says, three times at most.
          if [ "$STATUS" = 429 ] && [ $tries -lt 3 ] && ! grep -q '"quota"' "$TMP/body"; then
            wait="$(header_value retry-after)"; case "$wait" in ''|*[!0-9]*) wait=20 ;; esac
            tries=$((tries + 1)); sleep "$wait"; continue
          fi
          break
        done
        [ "${STATUS#2}" != "$STATUS" ] || thread_fail
        [ "$mode" != json ] || { cat "$TMP/body"; printf '\n'; continue; }
        thread_n() { local v; v="$(sed -n "s/.*\"$1\" *: *\\([0-9]*\\).*/\\1/p" "$TMP/body" | head -n 1)"; printf '%s' "${v:-0}"; }
        total_t=$((total_t + $(thread_n threads))); total_r=$((total_r + $(thread_n replies))); total_l=$((total_l + $(thread_n links)))
        total_s=$((total_s + $(thread_n sessions))); total_u=$((total_u + $(thread_n unchanged))); total_k=$((total_k + $(thread_n skipped)))
        total_h=$((total_h + $(thread_n hidden))); total_n=$((total_n + $(thread_n no_thread)))
        grep -o '"line":[0-9]*,"why":"[^"]*"' "$TMP/body" | sed 's/"line":\([0-9]*\),"why":"\(.*\)"/skipped a line (\1 of its part): \2/' >&2
      done
      [ "$mode" != json ] || return 0
      printf 'imported %s threads, %s replies, %s links, %s sessions; %s unchanged, %s skipped, %s with no thread\n' "$total_t" "$total_r" "$total_l" "$total_s" "$total_u" "$total_k" "$total_n"
      [ "$total_h" = 0 ] || note "$total_h piece(s) that looked like a secret were kept as [hidden]"
      ;;
    ref)
      [ $# -ge 1 ] || die 2 "thread ref KEY[#seq] --add REF... : the chat ids a message came to have"
      case "$1" in *#*) key="${1%%#*}"; seq="${1##*#}" ;; *) key="$1" ;; esac
      thread_key "$key"
      case "${seq:-0}" in ''|*[!0-9]*) die 2 "#seq is a reply's number" ;; esac
      [ ${#adds[@]} -gt 0 ] || die 2 "thread ref $1 --add REF..."
      a=""; for r2 in "${adds[@]}"; do a="${a}${a:+,}$(json_arg "$r2")"; done
      printf '{"add":[%s]%s}' "$a" "${seq:+,\"seq\":$seq}" > "$TMP/req"
      thread_post "/$key/ref" "$mode" || return 0
      grep -o '"added":\[[^]]*\]' "$TMP/body" | sed 's/"added":\[\(.*\)\]/kept: \1/;s/","/", "/g;s/"//g'
      ;;
    find)
      [ -n "$ref" ] || die 2 "thread find --ref REF : which message a chat id became"
      ACCEPT="application/json"
      api GET "/api/desk/threads/find?ref=$(urlencode "$ref")" -H "$(desk_auth)"
      [ "${STATUS#2}" != "$STATUS" ] || thread_fail
      [ "$mode" != json ] || { cat "$TMP/body"; printf '\n'; return 0; }
      sed -n 's/.*"address" *: *"\([^"]*\)".*/\1/p' "$TMP/body"
      ;;
    move)
      [ $# -ge 1 ] && [ -n "$into" ] || die 2 "thread move KEY --into KEY : a thread opened by mistake goes into another"
      thread_key "$1"; thread_key "$into"
      printf '{"into":%s}' "$(json_arg "$into")" > "$TMP/req"
      thread_post "/$1/move" "$mode" || return 0
      printf '%s went into %s\n' "$1" "$into"
      ;;
    show)
      [ $# -ge 1 ] || die 2 "thread show KEY"
      thread_key "$1"
      ACCEPT="application/json"
      api GET "/api/desk/threads/$1" -H "$(desk_auth)"
      [ "${STATUS#2}" != "$STATUS" ] || thread_fail
      [ "$mode" != json ] || { cat "$TMP/body"; printf '\n'; return 0; }
      thread_show "$TMP/body"
      ;;
    hook) cmd_thread_hook "$@" ;;
    *) die 2 "thread new | reply | link | status | ls | show | ref | find | move | import | hook (foldrender help thread)" ;;
  esac
}

#   ------------------------------------------------------------------ pack

# A context pack: what an agent picked out of this account's threads, pages
# and files, kept as it was, to hand to another session. A file or a text is
# checked here before anything is sent, so that a secret in it never leaves
# this machine: the server's patterns that a short grep can hold (src/desk.js
# SECRET_RES); the server checks again, long random runs too.
PACK_ITEM_MAX=16384
# The same prefixes as the server's (src/desk.js SECRET_RES), so that what the
# server would refuse is never sent to it. A prefix added there goes here too.
PACK_SECRET_RE='(sk-[A-Za-z0-9_-]{8,}|ghp_[A-Za-z0-9]{8,}|github_pat_|gh[ousr]_[A-Za-z0-9]{8,}|frat_[A-Za-z0-9]|frdk_[A-Za-z0-9]|AKIA[0-9A-Z]{12,}|xox[abprs]-[A-Za-z0-9-]*|tk_[0-9A-Z]{20,}|eyJ[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{8,}|[?&]k=[A-Za-z0-9_-]{6,}|glpat-[A-Za-z0-9_-]{8,}|AIza[A-Za-z0-9_-]{8,}|sk_live_[A-Za-z0-9]|hf_[A-Za-z0-9]{8,}|npm_[A-Za-z0-9]{8,}|SG\.[A-Za-z0-9_-]{8,}|frdm_[A-Za-z0-9_-]{8,})'
pack_ref() {
  case "$1" in
    p-*) case "$1" in p-[a-z0-9][a-z0-9][a-z0-9][a-z0-9][a-z0-9][a-z0-9][a-z0-9][a-z0-9][a-z0-9][a-z0-9][a-z0-9][a-z0-9]) return 0 ;; esac ;;
  esac
  case "$1" in ''|*[!A-Za-z0-9_.:-]*|[!A-Za-z0-9]*) die 2 "a pack is its id (p-…) or its name (foldrender pack ls lists them): $1" ;; esac
}
# pack_secret FILE LABEL: refuse FILE, before anything is sent, if a line of
# it looks like a secret (which line, never what is on it); with --redact,
# the copy sent has each kept as [hidden].
pack_secret() {
  local line
  line="$(grep -nE -- "$PACK_SECRET_RE|-----BEGIN [A-Z ]*KEY" "$1" | head -n 1 | cut -d: -f1)"
  [ -n "$line" ] || return 0
  [ -n "$PACK_REDACT" ] || die 2 "$2: line $line looks like it holds a secret (a key, a token, a private key, a link's ?k=); nothing was sent. Leave it out, or pass --redact to keep each as [hidden]"
  sed -E "/-----BEGIN [A-Z ]*KEY/,/-----END [A-Z ]*KEY/ s/.*/[hidden]/; s/$PACK_SECRET_RE/[hidden]/g" "$1" > "$1.red" && mv -f "$1.red" "$1" || die 1 "cannot write $1"
}
pack_field() {
  sed -n "s/.*\"$1\" *: *\"\{0,1\}\([^\",}]*\).*/\1/p; s/^$1: *//p" "$TMP/body" | head -n 1
}
pack_fail() {
  local msg item line
  msg="$(error_text)"
  case "$STATUS" in
    401) die 3 "not signed in, or the token was rejected ($msg). Run: foldrender login" ;;
    403) die 3 "$msg" ;;
    404) die 7 "${msg:-not found}" ;;
    413) die 5 "too large: $msg" ;;
    422)
      item="$(pack_field item)"; line="$(pack_field line)"
      if grep -q looks_like_secret "$TMP/body"; then
        case "${item:-}" in 0|'') die 1 "refused: the $(pack_field field) looks like a secret; nothing was kept" ;; esac
        die 1 "refused: item $item${line:+, line $line} looks like it holds a secret; nothing was kept. Leave it out, or pass --redact to keep each as [hidden]"
      fi
      die 1 "refused${item:+ (item $item)}: $msg" ;;
    400) die 1 "refused ($msg)$(pack_field field | sed 's/^./, field &/')" ;;
    429) die 4 "$msg" ;;
    409|503) die 1 "$msg" ;;
    *) fail_http ;;
  esac
}
cmd_pack() {
  case "${1:-}" in --help|-h|help) cmd_help pack; return 0 ;; esac
  local sub="${1:-ls}" mode=text goal="" name="" dry="" i=0 kind spec key range from to f size sha req q local_q n p s ref
  [ $# -eq 0 ] || shift
  PACK_REDACT=""
  local P_KIND=() P_ARG=() P_LABEL=() rest=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) mode=json; shift ;;
      --goal) need $# "$1"; goal="$2"; shift 2 ;;
      --name) need $# "$1"; name="$2"; shift 2 ;;
      --dry-run) dry=1; shift ;;
      --redact) PACK_REDACT=1; shift ;;
      --thread|--page|--file|--text|--text-file)
        need $# "$1"; P_KIND+=("${1#--}"); P_ARG+=("$2"); P_LABEL+=(""); shift 2 ;;
      --label)
        need $# "$1"
        n=${#P_KIND[@]}
        case "${P_KIND[$((n - 1))]:-}" in text|text-file) P_LABEL[$((n - 1))]="$2" ;; *) die 2 "--label names the --text (or --text-file) just before it" ;; esac
        shift 2 ;;
      --help|-h) cmd_help pack; return 0 ;;
      -*) die 2 "pack $sub: unknown option $1 (foldrender help pack)" ;;
      *) rest+=("$1"); shift ;;
    esac
  done
  set -- ${rest[@]+"${rest[@]}"}
  case "$sub" in
    new)
      [ $# -eq 0 ] || die 2 "pack new takes its items as options: --thread, --page, --file, --text (foldrender help pack)"
      [ ${#P_KIND[@]} -gt 0 ] || die 2 "a pack holds at least one item: --thread t-...[#N-M], --page PAGE, --file FILE, --text TEXT"
      [ ${#P_KIND[@]} -le 20 ] || die 2 "a pack holds at most 20 items"
      [ -z "$name" ] || pack_ref "$name"
      case "$name" in p-*) die 2 "--name is not a pack's id (p-…): choose another" ;; esac
      # Everything is read and checked here first: nothing is sent until every item is.
      : > "$TMP/items"
      while [ $i -lt ${#P_KIND[@]} ]; do
        kind="${P_KIND[$i]}"; spec="${P_ARG[$i]}"
        [ $i -eq 0 ] || printf ',' >> "$TMP/items"
        case "$kind" in
          thread)
            key="${spec%%#*}"; from=""; to=""
            thread_key "$key"
            if [ "$key" != "$spec" ]; then
              range="${spec#*#}"
              from="${range%%-*}"
              case "$range" in *-*) to="${range#*-}" ;; *) to="$from" ;; esac
              case "$from" in ''|*[!0-9]*) die 2 "--thread $spec: after # comes a message's number, or N-M, or N- (from N on)" ;; esac
              case "$to" in *[!0-9]*) die 2 "--thread $spec: after # comes a message's number, or N-M, or N- (from N on)" ;; esac
              [ "$from" -ge 1 ] || die 2 "--thread $spec: messages are numbered from 1"
              [ -z "$to" ] || [ "$to" -ge "$from" ] || die 2 "--thread $spec: $from comes after $to"
            fi
            printf '{"thread":%s%s%s}' "$(json_arg "$key")" "${from:+,\"from\":$from}" "${to:+,\"to\":$to}" >> "$TMP/items" ;;
          page)
            page_id "$spec"
            check_slug "$PAGE_ID"
            printf '{"page":%s}' "$(json_arg "$PAGE_ID")" >> "$TMP/items" ;;
          file)
            [ -f "$spec" ] || die 2 "no such file: $spec"
            [ -r "$spec" ] || die 2 "cannot read: $spec"
            case "$spec" in *$'\t'*|*$'\n'*) die 2 "--file $spec: a path with a tab or a line break in it cannot be named in a pack" ;; esac
            size="$(wc -c < "$spec" | tr -d ' ')"
            sha="$(sha256_of "$spec")"
            if [ "$size" -gt "$PACK_ITEM_MAX" ]; then
              # Too large to keep in a pack: where it is, what it was, and nothing of what it says.
              printf '{"file":%s,"sha256":"%s","bytes":%s}' "$(json_arg "$spec")" "$sha" "$size" >> "$TMP/items"
            else
              [ "$(tr -d '\000' < "$spec" | wc -c | tr -d ' ')" = "$size" ] || die 2 "--file $spec holds NUL bytes, so it is not text"
              cat "$spec" > "$TMP/pf.$i"
              pack_secret "$TMP/pf.$i" "--file $spec"
              printf '{"file":%s,"sha256":"%s","text":%s}' "$(json_arg "$spec")" "$sha" "$(json_file "$TMP/pf.$i")" >> "$TMP/items"
            fi ;;
          text|text-file)
            if [ "$kind" = text ]; then printf '%s' "$spec" > "$TMP/pf.$i"
            elif [ "$spec" = - ]; then cat > "$TMP/pf.$i"
            else [ -f "$spec" ] || die 2 "no such file: $spec"; cat "$spec" > "$TMP/pf.$i"; fi
            [ -s "$TMP/pf.$i" ] || die 2 "--$kind: there is no text"
            [ "$(wc -c < "$TMP/pf.$i" | tr -d ' ')" -le "$PACK_ITEM_MAX" ] || die 5 "--$kind: a text item is at most 16 KB; give a longer one as --file"
            pack_secret "$TMP/pf.$i" "--$kind"
            printf '{"text":%s%s}' "$(json_file "$TMP/pf.$i")" "${P_LABEL[$i]:+,\"label\":$(json_arg "${P_LABEL[$i]}")}" >> "$TMP/items" ;;
        esac
        i=$((i + 1))
      done
      if [ -n "$goal" ]; then
        printf '%s' "$goal" > "$TMP/pgoal"
        pack_secret "$TMP/pgoal" "--goal"
        goal="$(cat "$TMP/pgoal")"
      fi
      { printf '{"items":['; cat "$TMP/items"; printf ']'
        [ -z "$goal" ] || printf ',"goal":%s' "$(json_arg "$goal")"
        [ -z "$name" ] || printf ',"name":%s' "$(json_arg "$name")"
        [ -z "$PACK_REDACT" ] || printf ',"redact":true'
        printf '}'; } > "$TMP/req"
      ACCEPT="application/json"
      [ -z "$dry" ] || ACCEPT="text/plain"
      api POST "/api/packs${dry:+?dry_run=1}" -H "$(desk_auth)" -H "Content-Type: application/json" --data-binary "@$TMP/req"
      [ "${STATUS#2}" != "$STATUS" ] || pack_fail
      if [ -n "$dry" ] || [ "$mode" = json ]; then cat "$TMP/body"; [ -n "$dry" ] || printf '\n'; return 0; fi
      p="$(pack_field id)"
      printf '%s\n' "$p"
      n="$(pack_field pointers)"
      if [ "$(pack_field result)" = unchanged ]; then
        note "unchanged: the pack named $name holds these items already"
      else
        s="$(pack_field replaces)"
        note "made pack $p: $(pack_field items) item(s), about $(pack_field tokens) tokens${s:+; it replaces $s under the name $name}"
      fi
      [ "${n:-0}" = 0 ] || note "$n item(s) kept only as where to find them (too large); the pack says where"
      [ "$(pack_field hidden)" = 0 ] || note "$(pack_field hidden) piece(s) that looked like a secret were kept as [hidden]"
      note "read it, or hand it to another session: foldrender pack show $p"
      ;;
    show)
      [ $# -eq 1 ] || die 2 "pack show ID|NAME [--json]"
      pack_ref "$1"; ref="$1"
      if [ "$mode" = json ]; then
        ACCEPT="application/json"
        api GET "/api/packs/$ref?format=json" -H "$(desk_auth)"
        [ "${STATUS#2}" != "$STATUS" ] || pack_fail
        cat "$TMP/body"; printf '\n'
        return 0
      fi
      # Its files, compared with this machine's at the same path: the server
      # is told only same, changed or missing.
      ACCEPT="text/plain"
      api GET "/api/packs/$ref/files" -H "$(desk_auth)"
      [ "${STATUS#2}" != "$STATUS" ] || pack_fail
      local_q=""
      while IFS="$(printf '\t')" read -r n s f; do
        [ -n "$n" ] || continue
        if [ -f "$f" ]; then
          if [ "$(sha256_of "$f")" = "$s" ]; then q=same; else q=changed; fi
        else q=missing; fi
        local_q="${local_q:+$local_q,}$n:$q"
      done < "$TMP/body"
      api GET "/api/packs/$ref${local_q:+?local=$local_q}" -H "$(desk_auth)"
      [ "${STATUS#2}" != "$STATUS" ] || pack_fail
      cat "$TMP/body"
      ;;
    ls)
      [ $# -eq 0 ] || die 2 "pack ls [--json]"
      ACCEPT="text/plain"
      [ "$mode" != json ] || ACCEPT="application/json"
      api GET "/api/packs" -H "$(desk_auth)"
      [ "${STATUS#2}" != "$STATUS" ] || pack_fail
      cat "$TMP/body"
      [ "$mode" != json ] || printf '\n'
      ;;
    rm)
      [ $# -ge 1 ] || die 2 "pack rm ID|NAME..."
      for ref in "$@"; do pack_ref "$ref"; done
      for ref in "$@"; do
        ACCEPT="application/json"
        api DELETE "/api/packs/$ref" -H "$(desk_auth)"
        [ "${STATUS#2}" != "$STATUS" ] || pack_fail
        printf 'removed %s\n' "$(pack_field id)"
      done
      ;;
    *) die 2 "pack new | show | ls | rm (foldrender help pack)" ;;
  esac
}

# One thread as text (thread show): the words, then each session and reply.
# With Node to read the JSON; else the answer as it came.
thread_show() {
  if command -v node >/dev/null 2>&1; then
    node -e '
      const t = JSON.parse(require("fs").readFileSync(process.argv[1], "utf8"));
      const cut = (s, n) => { s = String(s || "").replace(/\s+/g, " ").trim(); return s.length > n ? s.slice(0, n - 1) + "…" : s; };
      console.log(`[${t.key}] ${t.state} · ${t.at}${t.by ? ` · ${t.by}` : ""}${t.parent ? ` · follows ${t.parent}` : ""}${t.moved ? ` · moved into this one from ${t.moved}` : ""}`);
      console.log(t.text);
      for (const s of t.sessions || []) console.log(`  session ${s.name}${s.machine ? ` on ${s.machine}` : ""}${s.parent ? ` (for ${s.parent})` : ""}${s.closed ? " closed" : ""}`);
      for (const e of t.events || []) console.log(`  #${e.seq} ${e.at} ${e.via ? `${e.via} reported` : e.by || "assistant"} (${e.kind}): ${cut(e.text, 200)}`);
      if (t.more) console.log(`  … and ${t.more} older replies`);
    ' "$1" || cat "$1"
  else
    cat "$1"
  fi
}

# foldrender thread hook claude|codex prompt|stop: what an agent's hooks run
# (UserPromptSubmit, Stop). prompt: the user's words become a thread (or a
# report from a session a thread was handed to is added to it), and the agent
# is told the address; stop: the turn's last reply goes under it. Never in the
# agent's way: anything that fails is silent (exit 0, nothing on stderr), and
# each call waits 6 seconds at most. FOLDRENDER_THREAD_AUTHOR names the user,
# FOLDRENDER_THREAD_CHANNEL where the words came from,
# FOLDRENDER_THREAD_SESSION the session's own name (bound to the thread),
# FOLDRENDER_THREAD_SKIP a file of prompt beginnings to leave out (one a
# line: a scheduled prompt's), FOLDRENDER_THREAD_AGENT the reply's author.
cmd_thread_hook() {
  local agent="${1:-}" event="${2:-}" sid state addr body
  case "$agent" in claude|codex) ;; install) shift; thread_hook_install "$@"; return ;; *) die 2 "thread hook claude|codex prompt|stop (or: thread hook install claude|codex)" ;; esac
  cat > "$TMP/in" 2>/dev/null || exit 0
  sid="$(json_get str session_id "$TMP/in" 2>/dev/null)"
  case "$sid" in ''|*[!A-Za-z0-9_.:-]*) exit 0 ;; esac
  state="$CONFIG_DIR/threads/$agent-$sid"
  mkdir -p "$CONFIG_DIR/threads" 2>/dev/null || exit 0
  [ -n "$TOKEN" ] || [ -n "${FOLDRENDER_DESK_TOKEN:-}" ] || exit 0
  case "$event" in
    prompt)
      rm -f "$state"
      json_get str prompt "$TMP/in" > "$TMP/text" 2>/dev/null || exit 0
      [ -s "$TMP/text" ] || exit 0
      printf '{"event":"prompt","prompt":%s,"author":%s,"channel":%s,"session":%s' "$(json_file "$TMP/text")" "$(json_arg "${FOLDRENDER_THREAD_AUTHOR:-owner}")" "$(json_arg "${FOLDRENDER_THREAD_CHANNEL:-$agent}")" "$(json_arg "${FOLDRENDER_THREAD_SESSION:-}")" > "$TMP/req.json"
      if [ -f "${FOLDRENDER_THREAD_SKIP:-}" ]; then
        printf ',"skip":[' >> "$TMP/req.json"
        head -n 20 "$FOLDRENDER_THREAD_SKIP" | awk 'NF' > "$TMP/skip"
        local first=1 line
        while IFS= read -r line; do printf '%s' "$line" > "$TMP/one"; [ $first = 1 ] || printf ',' >> "$TMP/req.json"; first=0; json_str "$TMP/one" >> "$TMP/req.json"; done < "$TMP/skip"
        printf ']' >> "$TMP/req.json"
      fi
      printf '}' >> "$TMP/req.json"
      api_once POST "/api/desk/threads/hook" -H "$(desk_auth)" -H "Content-Type: application/json" --data-binary "@$TMP/req.json" --max-time 6 || exit 0
      [ "${STATUS#2}" != "$STATUS" ] || exit 0
      addr="$(json_get str address "$TMP/body" 2>/dev/null)"
      [ -n "$addr" ] || exit 0
      printf '%s\n' "$addr" > "$state"
      json_get str context "$TMP/body" > "$TMP/ctx" 2>/dev/null || exit 0
      [ -s "$TMP/ctx" ] || exit 0
      printf '{"hookSpecificOutput":{"hookEventName":"UserPromptSubmit","additionalContext":%s}}\n' "$(json_file "$TMP/ctx")"
      ;;
    stop)
      [ -f "$state" ] || exit 0
      [ "$(json_get raw stop_hook_active "$TMP/in" 2>/dev/null)" != true ] || exit 0
      addr="$(head -n 1 "$state")"
      rm -f "$state"
      json_get str last_assistant_message "$TMP/in" > "$TMP/text" 2>/dev/null || exit 0
      [ -s "$TMP/text" ] || exit 0
      body="$(json_file "$TMP/text")"
      printf '{"event":"reply","address":%s,"text":%s,"author":%s,"ref":%s}' "$(json_arg "$addr")" "$body" "$(json_arg "${FOLDRENDER_THREAD_AGENT:-$agent}")" "$(json_arg "hook-$(printf '%s %s' "$addr" "$body" | cksum | tr ' ' '-')")" > "$TMP/req.json"
      api_once POST "/api/desk/threads/hook" -H "$(desk_auth)" -H "Content-Type: application/json" --data-binary "@$TMP/req.json" --max-time 6 || exit 0
      ;;
    *) die 2 "thread hook $agent prompt|stop" ;;
  esac
  exit 0
}

# foldrender thread hook install claude|codex [--author NAME] [--channel C]
# [--skip-file F]: the two hooks into the agent's settings (Claude Code
# ~/.claude/settings.json, Codex ~/.codex/hooks.json), kept beside the hooks
# already there; with Node to merge them in, else printed for you to add.
# Nothing else in the file changes.
thread_hook_install() {
  local agent="${1:-}" file self env="" a
  [ -n "$agent" ] && shift || die 2 "thread hook install claude|codex [--author NAME] [--channel C] [--skip-file FILE]"
  while [ $# -gt 0 ]; do
    case "$1" in
      --author) need $# "$1"; env="${env}FOLDRENDER_THREAD_AUTHOR='$(printf '%s' "$2" | sed "s/'/'\\\\''/g")' "; shift 2 ;;
      --channel) need $# "$1"; env="${env}FOLDRENDER_THREAD_CHANNEL='$(printf '%s' "$2" | sed "s/'/'\\\\''/g")' "; shift 2 ;;
      --session) need $# "$1"; env="${env}FOLDRENDER_THREAD_SESSION='$(printf '%s' "$2" | sed "s/'/'\\\\''/g")' "; shift 2 ;;
      --skip-file) need $# "$1"; a="$(cd "$(dirname "$2")" 2>/dev/null && pwd)/$(basename "$2")"; env="${env}FOLDRENDER_THREAD_SKIP='$a' "; shift 2 ;;
      *) die 2 "thread hook install $agent: unknown option $1" ;;
    esac
  done
  case "$agent" in
    claude) file="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/settings.json" ;;
    codex) file="${CODEX_HOME:-$HOME/.codex}/hooks.json" ;;
    *) die 2 "thread hook install claude|codex" ;;
  esac
  self="$(command -v foldrender 2>/dev/null || printf '%s' "$0")"
  local p="${env}'$self' thread hook $agent prompt" s="${env}'$self' thread hook $agent stop"
  if command -v node >/dev/null 2>&1; then
    mkdir -p "$(dirname "$file")" || die 1 "cannot make $(dirname "$file")"
    node -e '
      const fs = require("fs");
      const [file, p, s] = process.argv.slice(1);
      let j = {};
      if (fs.existsSync(file)) { j = JSON.parse(fs.readFileSync(file, "utf8") || "{}"); fs.copyFileSync(file, file + ".bak-foldrender"); }
      j.hooks = j.hooks || {};
      for (const [ev, cmd] of [["UserPromptSubmit", p], ["Stop", s]]) {
        const list = (j.hooks[ev] = j.hooks[ev] || []);
        const mine = / thread hook (claude|codex) (prompt|stop)"?$/;
        for (const g of list) g.hooks = (g.hooks || []).filter((h) => !(h && typeof h.command === "string" && mine.test(h.command)));
        list.push({ hooks: [{ type: "command", command: cmd, timeout: 10 }] });
      }
      for (const ev of ["UserPromptSubmit", "Stop"]) j.hooks[ev] = j.hooks[ev].filter((g) => (g.hooks || []).length);
      fs.writeFileSync(file, JSON.stringify(j, null, 2) + "\n");
    ' "$file" "$p" "$s" || die 1 "could not write the hooks into $file (it is kept as it was in $file.bak-foldrender)"
    note "added the message hooks to $file (UserPromptSubmit and Stop; the file before is $file.bak-foldrender). Each new session of $agent now writes the user's messages and its replies to the desk."
  else
    note "Node is not here to merge them in: add these two hooks to $file (the user's words become threads, the reply goes under them):"
    printf '{"hooks":{"UserPromptSubmit":[{"hooks":[{"type":"command","command":%s,"timeout":10}]}],"Stop":[{"hooks":[{"type":"command","command":%s,"timeout":10}]}]}}\n' "$(json_arg "$p")" "$(json_arg "$s")"
  fi
}

cmd_bridge() {
  local target="" agent="claude" dir="$PWD" session="" channel="" mesh_cli="" mcp="" node_major file cache url got
  while [ $# -gt 0 ]; do
    case "$1" in
      --page) need $# "$1"; target="$2"; shift 2 ;;
      --agent) need $# "$1"; agent="$2"; shift 2 ;;
      --session) need $# "$1"; session="$2"; shift 2 ;;
      --mesh-cli) need $# "$1"; mesh_cli="$2"; shift 2 ;;
      --mcp) need $# "$1"; mcp="$2"; shift 2 ;;
      --channel) channel=1; shift ;;
      --dir) need $# "$1"; dir="$2"; shift 2 ;;
      -*) die 2 "unknown option: $1" ;;
      *) [ -z "$target" ] || die 2 "bridge takes one page"; target="$1"; shift ;;
    esac
  done
  [ -n "$target" ] || die 2 "which page? foldrender bridge --page PAGE"
  case "$agent" in claude|codex|gemini|antigravity|grok|devin|pi) ;; *) die 2 "unknown agent: $agent (one of: claude, codex, gemini, antigravity, grok, devin, pi)" ;; esac
  [ -z "$mesh_cli" ] || [ -n "$session" ] || die 2 "--mesh-cli goes with --session NAME (the mesh's CLI that session's messages are sent with)"
  [ -d "$dir" ] || die 2 "--dir $dir is not a folder"
  [ -z "$mcp" ] || [ -z "$session$channel" ] || die 2 "--mcp is for an agent the bridge starts (--agent), not a terminal session"
  [ -z "$mcp" ] || [ -f "$mcp" ] || die 2 "--mcp $mcp is not a file"
  require_token
  command -v node >/dev/null 2>&1 || die 2 "the bridge needs Node 22 or later (https://nodejs.org); it is not installed"
  node_major="$(node -p 'process.versions.node.split(".")[0]' 2>/dev/null)"
  case "$node_major" in ''|*[!0-9]*) node_major=0 ;; esac
  [ "$node_major" -ge 22 ] || die 2 "the bridge needs Node 22 or later; this is $(node -v 2>/dev/null)"
  page_id "$target"
  if [ -n "${FOLDRENDER_BRIDGE:-}" ]; then
    file="$FOLDRENDER_BRIDGE"
    [ -f "$file" ] || die 2 "FOLDRENDER_BRIDGE=$file is not a file"
  else
    cache="${XDG_CACHE_HOME:-$HOME/.cache}/foldrender"
    file="$cache/bridge-$FR_BRIDGE_SHA256.mjs"
    if [ ! -f "$file" ] || [ "$(sha256_of "$file")" != "$FR_BRIDGE_SHA256" ]; then
      mkdir -p "$cache" || die 1 "cannot make $cache"
      # By its sha256: every released bridge stays on the site under its own
      # name, so an older foldrender keeps the bridge it was made with.
      url="${API%/artifacts}/install/bridge/$FR_BRIDGE_SHA256.mjs"
      curl -fsS --connect-timeout 15 --max-time 120 -o "$TMP/bridge.mjs" "$url" 2>"$TMP/err" || die 6 "cannot fetch the bridge from $url ($(curl_error))"
      got="$(sha256_of "$TMP/bridge.mjs")"
      [ "$got" = "$FR_BRIDGE_SHA256" ] || die 1 "the bridge at $url is not the one this foldrender ($FR_CLI_VERSION) runs; update foldrender: curl -fsSL ${API%/artifacts}/install.sh | sh"
      mv "$TMP/bridge.mjs" "$file" || die 1 "cannot write $file"
    fi
  fi
  export FOLDRENDER_TOKEN="$TOKEN"
  if [ -n "$channel" ]; then
    exec node "$file" --api "$API" --page "$PAGE_ID" --channel --dir "$dir"
  fi
  if [ -n "$session" ]; then
    if [ -n "$mesh_cli" ]; then
      exec node "$file" --api "$API" --page "$PAGE_ID" --session "$session" --mesh-cli "$mesh_cli" --dir "$dir"
    fi
    exec node "$file" --api "$API" --page "$PAGE_ID" --session "$session" --dir "$dir"
  fi
  if [ -n "$mcp" ]; then
    exec node "$file" --api "$API" --page "$PAGE_ID" --agent "$agent" --mcp "$mcp" --dir "$dir"
  fi
  exec node "$file" --api "$API" --page "$PAGE_ID" --agent "$agent" --dir "$dir"
}

# foldrender reply --page PAGE [--to N] TEXT|-|--file FILE: a terminal session's answer to
# a message in PAGE's agent sidebar (the bridge, --session, said how).
cmd_reply() {
  local target="" to="" text="" got_text="" file=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --page) need $# "$1"; target="$2"; shift 2 ;;
      --to)
        need $# "$1"
        case "$2" in ''|*[!0-9]*) die 2 "--to takes a message's number (the bridge's message says it)" ;; esac
        to="$2"; shift 2 ;;
      --file) need $# "$1"; file="$2"; shift 2 ;;
      -) text="$(cat)"; got_text=1; shift ;;
      -*) die 2 "unknown option: $1" ;;
      *) [ -z "$got_text" ] || die 2 "reply takes one text (quote it)"; text="$1"; got_text=1; shift ;;
    esac
  done
  if [ -n "$file" ]; then
    [ -f "$file" ] || die 2 "no such file: $file"
    if [ -L "$file" ]; then die 2 "refusing a symbolic link: $file"; fi
    [ -O "$file" ] || die 2 "not your file: $file"
    if [ -n "$(find "$file" -prune \( -perm -g+w -o -perm -o+w \) -print)" ]; then
      die 2 "file is writable by group or others: $file"
    fi
    text="$(cat "$file")"; got_text=1
  fi
  [ -n "$target" ] || die 2 "which page? foldrender reply --page PAGE [--to N] TEXT"
  [ -n "$got_text" ] && [ -n "$text" ] || die 2 "what is the answer? foldrender reply --page PAGE [--to N] TEXT (or - for standard input, or --file FILE)"
  page_id "$target"
  printf '%s' "$text" > "$TMP/reply.txt"
  { printf '{"text":'; json_str "$TMP/reply.txt"; [ -z "$to" ] || printf ',"to":%s' "$to"; printf '}'; } > "$TMP/reply.json"
  ACCEPT="application/json"
  api_auth POST "/api/artifacts/$PAGE_ID/agent/reply" -H "Content-Type: application/json" --data-binary "@$TMP/reply.json"
  ACCEPT="text/plain"
  case "$STATUS" in
    2??) printf 'replied in the sidebar (to message %s)\n' "$(json_get raw to 2>/dev/null || printf '?')" ;;
    404) die 7 "$(json_get str error 2>/dev/null || error_text)" ;;
    409) die 1 "$(json_get str error 2>/dev/null || error_text): run foldrender bridge --page $PAGE_ID --session NAME" ;;
    413) die 5 "$(json_get str error 2>/dev/null || error_text)" ;;
    429) die 4 "$(json_get str error 2>/dev/null || error_text)" ;;
    *) fail_http ;;
  esac
}

# sha256_of FILE: its sha256, in hex (sha256sum, or shasum on a Mac).
sha256_of() {
  if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1" | awk '{print $1}'
  else shasum -a 256 "$1" | awk '{print $1}'; fi
}

