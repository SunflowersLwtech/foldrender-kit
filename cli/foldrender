# help_asked CMD ARG...: whether ARGs ask for CMD's help (-h or --help), not
# counting the value of an option that takes one (edit --old --help).
help_asked() {
  local cmd="$1" skip="" a
  shift
  for a in "$@"; do
    if [ -n "$skip" ]; then skip=""; continue; fi
    case "$a" in
      -h|--help) return 0 ;;
      --old|--new|--title|--name|--folder|--share|--slug|--edits|--patch|--base|--assets|--save|-o|\
      --section|--card|--from|--max-tokens|--max-chars|--meta|--access|-n|--add|--rm|--note|--owner|\
      --confirm|--token|--timeout|--after|--notify|--ack|--to|--idempotency-key|--page|--agent|--dir|\
      --desk|--role|--context|--suggest|--option|--deadline|--product|--state|--device|--minutes|--session|\
      --next|--at|--match|--until|--reply-url|--lang|--done|--token-file|--log|--cli|--api|\
      --repo|--source|--basis|--expires) skip=1 ;;
      --link) [ "$cmd" != canvas ] || skip=1 ;;
    esac
  done
  return 1
}

main() {
  local cmd="${1:-help}"
  [ $# -eq 0 ] || shift
  case "$cmd" in
    login|logout|auth|account|export|whoami|publish|edit|share|list|ls|read|cat|versions|restore|undo|canvas|answers|desk|pack|bridge|rm|delete|open|version)
      if help_asked "$cmd" "$@"; then
        case "$cmd" in
          list) cmd_help ls ;;
          cat) cmd_help read ;;
          auth) cmd_help login ;;
          version) cmd_help ;;
          desk) if [ "${1:-}" = mem ]; then cmd_help desk-mem; else cmd_help desk; fi ;;
          *) cmd_help "$cmd" ;;
        esac
        return 0
      fi ;;
  esac
  case "$cmd" in
    login) cmd_login "$@" ;;
    logout) cmd_logout "$@" ;;
    auth) cmd_auth "$@" ;;
    account) cmd_account "$@" ;;
    export) cmd_export "$@" ;;
    whoami) cmd_whoami ;;
    publish) cmd_publish "$@" ;;
    edit) cmd_edit "$@" ;;
    share) cmd_share "$@" ;;
    list|ls) cmd_list "$@" ;;
    read|cat) cmd_read "$@" ;;
    log|versions) cmd_log "$@" ;;
    diff) cmd_diff "$@" ;;
    restore) cmd_restore "$@" ;;
    undo) cmd_undo "$@" ;;
    canvas) cmd_canvas "$@" ;;
    answers) cmd_answers "$@" ;;
    desk) cmd_desk "$@" ;;
    thread) cmd_thread "$@" ;;
    pack) cmd_pack "$@" ;;
    bridge) cmd_bridge "$@" ;;
    reply) cmd_reply "$@" ;;
    rm|delete) cmd_rm "$@" ;;
    open) cmd_open "$@" ;;
    version|--version) printf 'foldrender %s\n' "$FR_CLI_VERSION" ;;
    help|-h|--help) cmd_help "$@" ;;
    *) die 2 "unknown command: $cmd (try: foldrender help)" ;;
  esac
}

# --as LOGIN (or --as=LOGIN), anywhere: this command runs as that saved
# account. Not the value of an option that takes one (edit --old --as).
ARGS=()
skip=""
first=""
while [ $# -gt 0 ]; do
  if [ -n "$skip" ]; then ARGS+=("$1"); skip=""; shift; continue; fi
  case "$1" in
    --link) ARGS+=("$1"); case "$first" in canvas|desk) skip=1 ;; esac; shift; continue ;;
    --as) [ $# -ge 2 ] || die 2 "--as needs a value"; AS_LOGIN="$2"; shift 2 ;;
    --as=*) AS_LOGIN="${1#--as=}"; [ -n "$AS_LOGIN" ] || die 2 "--as needs a value"; shift ;;
    --old|--new|--title|--name|--folder|--share|--slug|--edits|--patch|--base|--assets|--save|-o|\
    --section|--card|--from|--max-tokens|--max-chars|--meta|--access|-n|--add|--rm|--note|--owner|\
    --confirm|--token|--timeout|--after|--notify|--ack|--to|--idempotency-key|--page|--agent|--dir|\
    --desk|--role|--context|--suggest|--option|--deadline|--product|--state|--device|--minutes|--session|\
    --next|--at|--match|--until|--reply-url|--lang|--done|--mesh-cli|--mcp|--id|\
    --key|--text-file|--kind|--by|--via|--ref|--parent|--channel|--machine|--agent|--limit|\
    --goal|--thread|--file|--text|--label)
      ARGS+=("$1"); skip=1; shift ;;
    *) [ -n "$first" ] || case "$1" in -*) ;; *) first="$1" ;; esac; ARGS+=("$1"); shift ;;
  esac
done
select_account
main ${ARGS[@]+"${ARGS[@]}"}
