      local key_re='^[A-Za-z0-9][A-Za-z0-9_.:-]{0,79}$'
      [[ "$key" =~ $key_re ]] || die 2 "desk card KEY --question Q --suggest S ...: KEY names the card (1 to 80 letters, digits, . _ : -, starting with a letter or digit), the same key again rewrites it"
      local question="" suggest="" context="" product="" by="" machine="" deadline="" heavy="" close="" why=""
      local opts=() links=() imgs=()
